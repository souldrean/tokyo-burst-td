					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Config: todos os numeros "ajustaveis" do jogo ficam aqui.
-- Assim, para mudar a velocidade de um inimigo, voce mexe em UM lugar so.
-- table.freeze deixa a tabela somente leitura: ninguem muda um valor por engano.
-- ATENCAO: ENEMIES, WAVES, WAVE_TIMEOUT_SECONDS, INTERMISSION_SECONDS, UNITS, START_CASH
-- e MAX_UNITS_PER_PLAYER tem uma copia em tools/sim_match.py. Se mudar aqui, mude la tambem (mantenha em sincronia).

local Types = require(script.Parent.Types)

local ENEMIES: { [string]: Types.EnemyDef } = {
	Grunt = {
		health = 20,
		speed = 20,
		baseDamage = 5,
		reward = 5,
		size = Vector3.new(2.4, 2.8, 2.4),
		color = Color3.fromRGB(170, 40, 60),
		eyeColor = Color3.fromRGB(255, 240, 80),
		horns = false,
	},
	Runner = {
		health = 12,
		speed = 32,
		baseDamage = 4,
		reward = 4,
		size = Vector3.new(1.8, 2.2, 1.8),
		color = Color3.fromRGB(255, 120, 30),
		eyeColor = Color3.fromRGB(255, 255, 255),
		horns = false,
	},
	Tank = {
		health = 90,
		speed = 14,
		baseDamage = 12,
		reward = 15,
		size = Vector3.new(4, 4.4, 4),
		color = Color3.fromRGB(90, 40, 140),
		eyeColor = Color3.fromRGB(255, 60, 60),
		horns = true,
	},
	Oni = {
		health = 600,
		speed = 12,
		baseDamage = 40,
		reward = 100,
		size = Vector3.new(6.5, 7.5, 6.5),
		color = Color3.fromRGB(200, 20, 20),
		eyeColor = Color3.fromRGB(255, 220, 0),
		horns = true,
	},
}

local WAVES: { Types.WaveDef } = {
	{ groups = { { kind = "Grunt", count = 5, interval = 1.2 } } },
	{ groups = { { kind = "Grunt", count = 8, interval = 1.0 } } },
	{ groups = { { kind = "Grunt", count = 6, interval = 1.0 }, { kind = "Runner", count = 4, interval = 0.8 } } },
	{ groups = { { kind = "Grunt", count = 8, interval = 0.8 }, { kind = "Tank", count = 2, interval = 2.0 } } },
	{ groups = { { kind = "Runner", count = 10, interval = 0.6 }, { kind = "Grunt", count = 6, interval = 0.8 } } },
	{ groups = { { kind = "Tank", count = 3, interval = 2.0 }, { kind = "Grunt", count = 10, interval = 0.7 } } },
	{ groups = { { kind = "Runner", count = 12, interval = 0.5 }, { kind = "Tank", count = 3, interval = 1.5 } } },
	{
		groups = {
			{ kind = "Grunt", count = 15, interval = 0.5 },
			{ kind = "Tank", count = 4, interval = 1.5 },
			{ kind = "Runner", count = 6, interval = 0.5 },
		},
	},
	{
		groups = {
			{ kind = "Tank", count = 6, interval = 1.0 },
			{ kind = "Runner", count = 14, interval = 0.4 },
			{ kind = "Grunt", count = 10, interval = 0.5 },
		},
	},
	{
		groups = {
			{ kind = "Grunt", count = 8, interval = 0.6 },
			{ kind = "Tank", count = 4, interval = 1.2 },
			{ kind = "Oni", count = 1, interval = 1.0 },
		},
		boss = true,
	},
}

-- Unidades (semana 3). Numeros calibrados com tools/sim_match.py (cenario c).
-- Os slots ficam a ~12-14 studs do centro da estrada, por isso os alcances sao altos.
local UNITS: { [string]: Types.UnitDef } = {
	Ninja = {
		displayName = "Ninja",
		cost = 50,
		range = 28,
		damage = 8,
		cooldown = 0.5,
		splashRadius = 0,
		color = Color3.fromRGB(40, 44, 70),
		accentColor = Color3.fromRGB(60, 220, 255),
		height = 5,
		attackStyle = "Shuriken",
	},
	Samurai = {
		displayName = "Samurai",
		cost = 160,
		range = 18,
		damage = 30,
		cooldown = 1.4,
		splashRadius = 0,
		color = Color3.fromRGB(190, 40, 50),
		accentColor = Color3.fromRGB(255, 200, 60),
		height = 5.6,
		attackStyle = "Slash",
	},
	Mage = {
		displayName = "Mage",
		cost = 260,
		range = 24,
		damage = 13,
		cooldown = 1.4,
		splashRadius = 9,
		color = Color3.fromRGB(90, 60, 170),
		accentColor = Color3.fromRGB(230, 90, 255),
		height = 5.4,
		attackStyle = "Orb",
	},
}

local Config = {
	-- Cubo de teste da semana 1 (codigo mantido, mas desligado).
	PATH_PREVIEW_ENABLED = false,
	PATH_PREVIEW_SPEED = 20,
	PATH_PREVIEW_CUBE_SIZE = 3,
	PATH_PREVIEW_HEIGHT = 2,

	-- Partida
	INTERMISSION_SECONDS = 6, -- pausa antes da primeira onda
	RESTART_DELAY_SECONDS = 8, -- tempo na tela de Vitoria/Derrota antes de recomecar
	BASE_MAX_HEALTH = 100,
	WAVE_TIMEOUT_SECONDS = 15, -- depois disto a proxima onda comeca mesmo com inimigos vivos

	-- Servidor
	SERVER_TICK_RATE = 10, -- vezes por segundo que o servidor confere se inimigos chegaram ao fim
	MAX_ENEMIES_ALIVE = 60, -- limite de seguranca

	-- Unidades e dinheiro (semana 3)
	START_CASH = 60, -- dinheiro de cada jogador no inicio da partida
	MAX_UNITS_PER_PLAYER = 6,
	-- Estados em que pode colocar unidade (conjunto: chave = estado, valor = true).
	PLACE_ALLOWED_STATES = { Intermission = true, Wave = true } :: { [string]: boolean },
	UNIT_ORDER = { "Ninja", "Samurai", "Mage" } :: { string }, -- ordem da hotbar

	-- Debug (so no Studio)
	DEBUG_HIT_DAMAGE = 5,

	ENEMIES = ENEMIES,
	WAVES = WAVES,
	UNITS = UNITS,
}

return table.freeze(Config)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Net: acesso centralizado aos RemoteEvents.
-- No servidor: cria a pasta ReplicatedStorage.Remotes e cada evento sob demanda
-- (assim a ordem de init() entre sistemas nao importa).
-- No cliente: so espera o evento existir (cliente nunca cria remotes).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Types = require(script.Parent.Types)

export type RemoteName = Types.RemoteName

local FOLDER_NAME = "Remotes"
local CLIENT_TIMEOUT = 30

local Net = {}

local function getServerFolder(): Folder
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		assert(existing:IsA("Folder"), "Net: ReplicatedStorage.Remotes deveria ser uma Folder")
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	return folder
end

function Net.event(name: RemoteName): RemoteEvent
	if RunService:IsServer() then
		local folder = getServerFolder()
		local existing = folder:FindFirstChild(name)
		if existing then
			assert(existing:IsA("RemoteEvent"), `Net: "{name}" deveria ser um RemoteEvent`)
			return existing
		end
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		return remote
	end

	-- Cliente: espera com tempo limite e erro claro.
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_TIMEOUT)
	assert(folder, `Net: ReplicatedStorage.Remotes nao apareceu em {CLIENT_TIMEOUT}s`)
	local remote = folder:WaitForChild(name, CLIENT_TIMEOUT)
	assert(remote, `Net: o RemoteEvent "{name}" nao apareceu em {CLIENT_TIMEOUT}s`)
	assert(remote:IsA("RemoteEvent"), `Net: "{name}" deveria ser um RemoteEvent`)
	return remote
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000005">
				<Properties>
					<string name="Name">Types</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Types: tipos compartilhados entre servidor e cliente.
-- Tipos so existem para o verificador de codigo (nao rodam no jogo).
-- Um ModuleScript precisa devolver um valor, entao devolvemos uma tabela vazia
-- (devolver "nil" puro da erro no Roblox).

-- Dados pre-calculados de um caminho feito de pontos ligados por retas.
export type PathData = {
	points: { Vector3 }, -- os waypoints, em ordem
	lengths: { number }, -- lengths[i] = distancia do ponto i ate o ponto i+1
	total: number, -- comprimento total do caminho
}

-- Nomes dos RemoteEvents (a lista fica aqui para cliente e servidor concordarem).
export type RemoteName =
	"EnemyDied"
	| "BaseHit"
	| "WaveStarted"
	| "MatchEnded"
	| "DebugHitEnemy"
	| "PlaceUnit"
	| "UnitPlaced"
	| "UnitAttacked"
	| "Notify"

-- Por que um inimigo saiu do jogo: morto por nos ou chegou no fim (vazou).
export type DeathReason = "Killed" | "Leaked"

export type MatchResult = "Victory" | "Defeat"

-- Estados da partida (atributo State em ReplicatedStorage.MatchState).
export type MatchStateName = "Waiting" | "Intermission" | "Wave" | "Victory" | "Defeat"

-- Payloads (ordem dos argumentos de cada RemoteEvent, servidor -> clientes):
--   EnemyDied(id: string, reason: DeathReason, position: Vector3, reward: number)
--   BaseHit(damage: number, healthLeft: number)
--   WaveStarted(wave: number, waveCount: number, isBoss: boolean)
--   MatchEnded(result: MatchResult)
--   DebugHitEnemy(id: string)   <- cliente -> servidor (so no Studio)
--   (semana 3)
--   PlaceUnit(kind: string, slotName: string)        <- cliente -> servidor
--   UnitPlaced(id: string, kind: string, position: Vector3, ownerUserId: number)   <- todos
--   UnitAttacked(id: string, kind: string, from: Vector3, to: Vector3)             <- todos
--   Notify(text: string)                              <- servidor -> UM cliente
export type EnemyDiedPayload = {
	id: string,
	reason: DeathReason,
	position: Vector3,
	reward: number,
}

-- Dados de um tipo de inimigo (vem do Config.ENEMIES).
export type EnemyDef = {
	health: number,
	speed: number,
	baseDamage: number,
	reward: number,
	size: Vector3,
	color: Color3,
	eyeColor: Color3,
	horns: boolean,
}

-- Como a unidade ataca (so muda o visual do ataque no cliente).
export type AttackStyle = "Shuriken" | "Slash" | "Orb"

-- Dados de um tipo de unidade/torre (vem do Config.UNITS).
export type UnitDef = {
	displayName: string,
	cost: number,
	range: number, -- studs, distancia no plano XZ
	damage: number,
	cooldown: number, -- segundos entre ataques
	splashRadius: number, -- 0 = dano em um alvo so
	color: Color3, -- corpo
	accentColor: Color3, -- partes neon e projetil
	height: number,
	attackStyle: AttackStyle,
}

-- Uma linha do "retrato" dos inimigos vivos (EnemyService.snapshot).
export type SnapshotEntry = {
	id: string,
	distance: number, -- studs andados no caminho
	position: Vector3, -- centro do inimigo no mundo
}

-- Um grupo de inimigos do mesmo tipo dentro de uma onda.
export type WaveGroup = {
	kind: string,
	count: number,
	interval: number, -- segundos entre cada spawn
}

export type WaveDef = {
	groups: { WaveGroup },
	boss: boolean?,
}

return {}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000006">
				<Properties>
					<string name="Name">Util</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000007">
					<Properties>
						<string name="Name">EnemyMath</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EnemyMath: matematica PURA do movimento dos inimigos.
-- O servidor nao move inimigos todo frame: guarda so (BaseDistance, BaseTime, Speed).
-- Servidor e clientes usam esta MESMA formula, entao todo mundo ve o inimigo no mesmo lugar.

local EnemyMath = {}

-- distancia(agora) = BaseDistance + Speed * (agora - BaseTime)
-- Nunca devolve negativo (se o relogio do cliente estiver um pouco atrasado).
function EnemyMath.distanceAt(baseDistance: number, baseTime: number, speed: number, now: number): number
	local d = baseDistance + speed * (now - baseTime)
	if d ~= d or d < 0 then -- "d ~= d" so e verdade para NaN
		return 0
	end
	return d
end

return EnemyMath
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000008">
					<Properties>
						<string name="Name">PathMath</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- PathMath: matematica PURA de caminhos (nao usa nenhum servico do Roblox).
-- Por ser pura, e facil de testar: mesma entrada, sempre a mesma saida.
-- Ideia: o caminho e uma linha quebrada (polilinha). Dada uma distancia
-- percorrida, descobrimos em que reta estamos e onde exatamente.

local Types = require(script.Parent.Parent.Types)

local PathMath = {}

-- Calcula o tamanho de cada reta e o total UMA vez.
-- Depois, consultar posicoes fica barato (bom para rodar todo frame).
function PathMath.build(points: { Vector3 }): Types.PathData
	local lengths: { number } = {}
	local total = 0
	for i = 1, #points - 1 do
		local len = (points[i + 1] - points[i]).Magnitude
		lengths[i] = len
		total += len
	end
	return { points = table.clone(points), lengths = lengths, total = total }
end

function PathMath.totalLength(points: { Vector3 }): number
	return PathMath.build(points).total
end

-- Descobre em qual reta (indice) a distancia cai e a fracao t (0 a 1) dentro dela.
-- Casos de borda: distancia negativa/NaN vira 0; maior que o total vira o fim;
-- retas de tamanho zero sao puladas (evita divisao por zero).
function PathMath.segmentAt(data: Types.PathData, distance: number): (number, number)
	local segmentCount = #data.lengths
	if segmentCount == 0 then
		return 1, 0
	end

	local d = distance
	if d ~= d or d < 0 then -- "d ~= d" so e verdade para NaN
		d = 0
	elseif d > data.total then
		d = data.total
	end

	for i = 1, segmentCount do
		local len = data.lengths[i]
		if len > 0 then
			if d <= len then
				return i, d / len
			end
			d -= len
		end
	end

	-- Sobrou por erro de arredondamento (ou tudo tem tamanho zero): fim da ultima reta.
	return segmentCount, 1
end

-- Posicao no mundo depois de andar "distance" studs desde o primeiro ponto.
function PathMath.positionAt(data: Types.PathData, distance: number): Vector3
	local pointCount = #data.points
	assert(pointCount >= 1, "PathMath.positionAt: caminho sem pontos")
	if pointCount == 1 then
		return data.points[1]
	end

	local index, t = PathMath.segmentAt(data, distance)
	return data.points[index]:Lerp(data.points[index + 1], t)
end

-- Direcao (vetor unitario no plano XZ) da reta onde a distancia cai.
-- Serve para o inimigo "olhar" para onde esta andando. Se nao der para calcular
-- (sem retas, ou reta so vertical), devolve Vector3.zAxis como valor seguro.
function PathMath.directionAt(data: Types.PathData, distance: number): Vector3
	if #data.points < 2 then
		return Vector3.zAxis
	end

	local index = PathMath.segmentAt(data, distance)
	local delta = data.points[index + 1] - data.points[index]
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if flat.Magnitude < 1e-4 then
		return Vector3.zAxis
	end
	return flat.Unit
end

return PathMath
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX00000009">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX0000000A">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Ponto de entrada do servidor: o UNICO Script do servidor.
-- Inicia em duas fases: primeiro init() de todos, depois start() de todos.
-- Assim nenhum sistema comeca a rodar antes de os outros estarem prontos.

local Systems = script:WaitForChild("Systems")

local loaded: { any } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		table.insert(loaded, require(child))
	end
end

-- Fase 1: preparar (rapida, sem loops longos).
for _, system in loaded do
	if typeof(system.init) == "function" then
		system.init()
	end
end

-- Fase 2: comecar. task.spawn evita que um start travado bloqueie os outros.
for _, system in loaded do
	if typeof(system.start) == "function" then
		task.spawn(system.start)
	end
end
]]></ProtectedString>
			</Properties>
			<Item class="Folder" referent="RBX0000000B">
				<Properties>
					<string name="Name">Systems</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX0000000C">
					<Properties>
						<string name="Name">BaseService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- BaseService: guarda a vida da base. So o servidor muda esse numero.
-- MatchService escuta onChanged para copiar o valor para o atributo MatchState.BaseHealth.
-- (Assim BaseService nao precisa conhecer MatchService: evita require circular.)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local BaseService = {}

local health: number = Config.BASE_MAX_HEALTH
local baseHitRemote: RemoteEvent? = nil

type ChangedCallback = (health: number, maxHealth: number) -> ()
local listeners: { ChangedCallback } = {}

local function notify()
	for _, callback in listeners do
		callback(health, Config.BASE_MAX_HEALTH)
	end
end

function BaseService.init()
	baseHitRemote = Net.event("BaseHit")
end

-- Registra uma funcao chamada quando a vida muda. Devolve uma funcao para cancelar.
function BaseService.onChanged(callback: ChangedCallback): () -> ()
	table.insert(listeners, callback)
	return function()
		local index = table.find(listeners, callback)
		if index then
			table.remove(listeners, index)
		end
	end
end

function BaseService.getHealth(): number
	return health
end

function BaseService.isDead(): boolean
	return health <= 0
end

function BaseService.damage(amount: number)
	-- Defesa: ignora valores estranhos (NaN, negativo, zero) e base ja destruida.
	if amount ~= amount or amount <= 0 or health <= 0 then
		return
	end
	local dealt = math.min(amount, health)
	health = math.max(0, health - amount)
	if baseHitRemote then
		baseHitRemote:FireAllClients(dealt, health)
	end
	notify()
end

function BaseService.reset()
	health = Config.BASE_MAX_HEALTH
	notify()
end

return BaseService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000D">
					<Properties>
						<string name="Name">DebugService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- DebugService: ferramenta de teste SO para o Studio.
-- O cliente clica num inimigo e manda DebugHitEnemy(id); o servidor valida tudo
-- (nunca confie no cliente) e aplica dano pelo mesmo caminho do jogo real.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local EnemyService = require(script.Parent.EnemyService)

local DebugService = {}

local MAX_ID_LENGTH = 16
local RATE_PER_SECOND = 10 -- maximo de cliques por segundo por jogador
local BURST = 10

type Bucket = { tokens: number, last: number }
local buckets: { [Player]: Bucket } = {}
local connections: { RBXScriptConnection } = {}

-- "Balde de fichas": cada clique gasta 1 ficha; as fichas voltam com o tempo.
local function allow(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { tokens = BURST, last = now }
		buckets[player] = bucket
	end
	bucket.tokens = math.min(BURST, bucket.tokens + (now - bucket.last) * RATE_PER_SECOND)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function DebugService.init()
	-- Fora do Studio nem criamos o remote nem ligamos o handler.
	if not RunService:IsStudio() then
		return
	end

	local remote = Net.event("DebugHitEnemy")
	table.insert(
		connections,
		remote.OnServerEvent:Connect(function(player: Player, id: unknown)
			if not allow(player) then
				return
			end
			-- Tipo e tamanho primeiro; so depois usamos o valor.
			if typeof(id) ~= "string" then
				return
			end
			if #id > MAX_ID_LENGTH then
				return
			end
			-- O inimigo precisa existir (getDistance devolve nil se nao existir).
			if EnemyService.getDistance(id) == nil then
				return
			end
			EnemyService.damage(id, Config.DEBUG_HIT_DAMAGE)
		end)
	)

	-- Jogador saiu: apaga o balde dele (senao a tabela guardaria o Player para sempre).
	table.insert(
		connections,
		Players.PlayerRemoving:Connect(function(player: Player)
			buckets[player] = nil
		end)
	)
end

-- Limpeza explicita (nao usada no jogo normal).
function DebugService.destroy()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	table.clear(buckets)
end

return DebugService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000E">
					<Properties>
						<string name="Name">EconomyService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EconomyService: dinheiro da partida de cada jogador.
-- So o servidor mexe no dinheiro. Guardamos numa tabela (fonte da verdade) e copiamos
-- para o atributo "Cash" do Player, so para o HUD do cliente conseguir ler.
-- Regra co-op: quando um inimigo e MORTO, TODOS os jogadores ganham a recompensa.
-- Este modulo NAO pode dar require no MatchService (evita require circular):
-- o MatchService e quem chama resetAll().

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Types = require(Shared:WaitForChild("Types"))

local EnemyService = require(script.Parent.EnemyService)

local EconomyService = {}

-- Tabela por jogador. E limpa no PlayerRemoving (senao guardaria o Player para sempre).
local cash: { [Player]: number } = {}
local connections: { RBXScriptConnection } = {}
local cleanups: { () -> () } = {}

-- Numero valido = nao e NaN e nao e infinito.
local function isFinite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

local function setCash(player: Player, value: number)
	cash[player] = value
	player:SetAttribute("Cash", value) -- o HUD le este atributo
end

local function onPlayerAdded(player: Player)
	-- Quem entra no meio da partida tambem comeca com START_CASH.
	setCash(player, Config.START_CASH)
end

function EconomyService.init()
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	table.insert(connections, Players.PlayerAdded:Connect(onPlayerAdded))
	table.insert(
		connections,
		Players.PlayerRemoving:Connect(function(player: Player)
			cash[player] = nil
		end)
	)

	-- Inimigo morto -> todo mundo ganha. Vazou (Leaked) nao da nada.
	table.insert(
		cleanups,
		EnemyService.onEnemyRemoved(function(_id: string, reason: Types.DeathReason, reward: number)
			if reason == "Killed" then
				EconomyService.addAll(reward)
			end
		end)
	)
end

function EconomyService.get(player: Player): number
	return cash[player] or 0
end

-- Soma dinheiro (n precisa ser positivo e finito; senao ignora).
function EconomyService.add(player: Player, n: number)
	if not isFinite(n) or n <= 0 then
		return
	end
	local current = cash[player]
	if current == nil then
		return -- jogador que ja saiu
	end
	setCash(player, current + n)
end

-- Tenta gastar. Devolve true so se tinha dinheiro (e ja desconta).
function EconomyService.trySpend(player: Player, n: number): boolean
	if not isFinite(n) or n < 0 then
		return false
	end
	local current = cash[player]
	if current == nil or current < n then
		return false
	end
	setCash(player, current - n)
	return true
end

function EconomyService.addAll(n: number)
	for player in cash do
		EconomyService.add(player, n)
	end
end

-- Volta todo mundo para START_CASH (nova partida).
function EconomyService.resetAll()
	for player in cash do
		setCash(player, Config.START_CASH)
	end
end

-- Limpeza explicita (nao usada no jogo normal).
function EconomyService.destroy()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, cleanup in cleanups do
		cleanup()
	end
	table.clear(cleanups)
	table.clear(cash)
end

return EconomyService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000F">
					<Properties>
						<string name="Name">EnemyService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- EnemyService: cria, guarda e remove os inimigos.
-- IDEIA CENTRAL: o servidor NAO move inimigos todo frame. Cada inimigo guarda
-- (BaseDistance, BaseTime, Speed) e a distancia agora e:
--   BaseDistance + Speed * (agora - BaseTime)
-- O servidor confere isso 10 vezes por segundo (so para saber se chegou ao fim).
-- Cada cliente calcula a mesma formula todo frame e move a sua copia local do modelo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))
local PathMath = require(Shared:WaitForChild("Util"):WaitForChild("PathMath"))
local EnemyMath = require(Shared:WaitForChild("Util"):WaitForChild("EnemyMath"))

local PathService = require(script.Parent.PathService)
local BaseService = require(script.Parent.BaseService)

local EnemyService = {}

type Enemy = {
	model: Model,
	kind: string,
	health: number,
	maxHealth: number,
	speed: number,
	baseDistance: number,
	baseTime: number,
	baseDamage: number,
	reward: number,
	heightOffset: number,
}

-- reward: o que o inimigo vale (0 se vazou). Quem so quer id/reason pode ignorar o resto.
type RemovedCallback = (id: string, reason: Types.DeathReason, reward: number) -> ()

-- Tabela por id: assim nunca precisamos varrer o workspace a cada tick.
local enemies: { [string]: Enemy } = {}
local aliveCount = 0
local nextId = 0
local container: Folder? = nil
local diedRemote: RemoteEvent? = nil
local tickConnection: RBXScriptConnection? = nil
local removedListeners: { RemovedCallback } = {}

-- Lista reaproveitada a cada tick (evita criar uma tabela nova 10x por segundo).
local leakedBuffer: { string } = {}

-- Lista reaproveitada do snapshot(): as linhas sao tabelas fixas que so tem os campos reescritos.
local snapshotBuffer: { Types.SnapshotEntry } = {}

local HORN_COLOR = Color3.fromRGB(235, 228, 205)

-- Cria uma peca de enfeite soldada ao Root.
local function makeDecoration(name: string, root: BasePart, size: Vector3, color: Color3, offset: CFrame, neon: boolean)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false -- so o Root e clicavel
	part.CFrame = root.CFrame * offset
	part.Parent = root.Parent
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
end

-- Monta o visual "demonio": corpo em bloco + 2 olhos Neon + chifres (Tank/Oni).
-- Feito pelo SERVIDOR uma vez no spawn; depois so os clientes movem a copia local.
local function buildModel(id: string, kind: string, def: Types.EnemyDef, startCFrame: CFrame): Model
	local model = Instance.new("Model")
	model.Name = id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = def.size
	root.Color = def.color
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = true -- clicavel (debug)
	root.CFrame = startCFrame
	root.Parent = model
	model.PrimaryPart = root

	-- Olhos na frente (a frente do CFrame.lookAt e o eixo -Z).
	local eye = math.max(0.35, def.size.X * 0.14)
	local eyeSize = Vector3.new(eye, eye, eye * 0.6)
	for _, side in { -1, 1 } do
		makeDecoration(
			"Eye",
			root,
			eyeSize,
			def.eyeColor,
			CFrame.new(side * def.size.X * 0.22, def.size.Y * 0.15, -def.size.Z / 2),
			true
		)
	end

	if def.horns then
		local hornHeight = def.size.Y * 0.35
		local hornWidth = math.max(0.4, def.size.X * 0.12)
		for _, side in { -1, 1 } do
			makeDecoration(
				"Horn",
				root,
				Vector3.new(hornWidth, hornHeight, hornWidth),
				HORN_COLOR,
				CFrame.new(side * def.size.X * 0.3, def.size.Y / 2 + hornHeight / 2 - 0.05, 0)
					* CFrame.Angles(0, 0, -side * 0.3),
				false
			)
		end
	end

	return model
end

-- Remove o inimigo da tabela, destroi o modelo e avisa quem escuta.
local function remove(id: string, reason: Types.DeathReason)
	local enemy = enemies[id]
	if not enemy then
		return
	end
	enemies[id] = nil
	aliveCount -= 1
	enemy.model:Destroy()
	-- Vazou nao da dinheiro; so quem foi morto vale a recompensa.
	local reward = if reason == "Killed" then enemy.reward else 0
	for _, callback in removedListeners do
		callback(id, reason, reward)
	end
end

local function currentDistance(enemy: Enemy, now: number): number
	return EnemyMath.distanceAt(enemy.baseDistance, enemy.baseTime, enemy.speed, now)
end

-- Posicao do centro do inimigo (para os efeitos dos clientes).
local function centerPosition(enemy: Enemy, distance: number): Vector3
	return PathMath.positionAt(PathService.getPathData(), distance) + Vector3.yAxis * enemy.heightOffset
end

local function fireDied(id: string, reason: Types.DeathReason, position: Vector3, reward: number)
	if diedRemote then
		diedRemote:FireAllClients(id, reason, position, reward)
	end
end

function EnemyService.init()
	local folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace
	container = folder
	diedRemote = Net.event("EnemyDied")
end

-- Cria um inimigo no inicio do caminho. Devolve o id, ou nil se nao puder criar.
function EnemyService.spawn(kind: string): string?
	local folder = container
	if not folder then
		return nil
	end
	local def = Config.ENEMIES[kind]
	if not def then
		warn(`EnemyService.spawn: tipo desconhecido "{kind}"`)
		return nil
	end
	if aliveCount >= Config.MAX_ENEMIES_ALIVE then
		return nil -- limite de seguranca
	end

	nextId += 1
	local id = `E{nextId}`
	local data = PathService.getPathData()
	local heightOffset = def.size.Y / 2
	local startPos = PathMath.positionAt(data, 0) + Vector3.yAxis * heightOffset
	local startCFrame = CFrame.lookAt(startPos, startPos + PathMath.directionAt(data, 0))
	local now = workspace:GetServerTimeNow()

	local model = buildModel(id, kind, def, startCFrame)
	model:SetAttribute("Id", id)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Health", def.health)
	model:SetAttribute("MaxHealth", def.health)
	model:SetAttribute("Speed", def.speed)
	model:SetAttribute("BaseDistance", 0)
	model:SetAttribute("BaseTime", now)
	model:SetAttribute("HeightOffset", heightOffset)
	model.Parent = folder

	enemies[id] = {
		model = model,
		kind = kind,
		health = def.health,
		maxHealth = def.health,
		speed = def.speed,
		baseDistance = 0,
		baseTime = now,
		baseDamage = def.baseDamage,
		reward = def.reward,
		heightOffset = heightOffset,
	}
	aliveCount += 1
	return id
end

-- Tira vida do inimigo. Se chegar a 0: avisa os clientes (Killed) e remove.
function EnemyService.damage(id: string, amount: number)
	local enemy = enemies[id]
	if not enemy then
		return
	end
	if amount ~= amount or amount <= 0 then
		return
	end
	enemy.health = math.max(0, enemy.health - amount)
	enemy.model:SetAttribute("Health", enemy.health)
	if enemy.health <= 0 then
		local position = centerPosition(enemy, currentDistance(enemy, workspace:GetServerTimeNow()))
		fireDied(id, "Killed", position, enemy.reward)
		remove(id, "Killed")
	end
end

-- Muda a velocidade fazendo "rebase": guarda onde o inimigo esta AGORA como nova base.
-- Sem isso, o inimigo daria um pulo para tras/frente quando a velocidade mudasse.
function EnemyService.setSpeed(id: string, speed: number)
	local enemy = enemies[id]
	if not enemy then
		return
	end
	if speed ~= speed or speed < 0 then
		return
	end
	local now = workspace:GetServerTimeNow()
	enemy.baseDistance = currentDistance(enemy, now)
	enemy.baseTime = now
	enemy.speed = speed
	-- Ordem nao importa para o cliente: ele le tudo do mesmo jeito (atributos replicam juntos).
	enemy.model:SetAttribute("BaseDistance", enemy.baseDistance)
	enemy.model:SetAttribute("BaseTime", now)
	enemy.model:SetAttribute("Speed", speed)
end

function EnemyService.getDistance(id: string): number?
	local enemy = enemies[id]
	if not enemy then
		return nil
	end
	return currentDistance(enemy, workspace:GetServerTimeNow())
end

-- "Retrato" dos inimigos vivos para o combate das unidades (chamado 10x por segundo).
-- Devolve (lista, quantidade). So as primeiras "quantidade" linhas valem: o resto e lixo
-- de chamadas anteriores. A lista e REUSADA, entao nao guarde ela entre ticks.
function EnemyService.snapshot(): ({ Types.SnapshotEntry }, number)
	local now = workspace:GetServerTimeNow()
	local count = 0
	for id, enemy in enemies do
		count += 1
		local distance = currentDistance(enemy, now)
		local entry = snapshotBuffer[count]
		if not entry then
			entry = { id = id, distance = distance, position = Vector3.zero }
			snapshotBuffer[count] = entry
		end
		entry.id = id
		entry.distance = distance
		entry.position = centerPosition(enemy, distance)
	end
	return snapshotBuffer, count
end

-- Remove todos sem disparar eventos (usado ao terminar/reiniciar a partida).
function EnemyService.clearAll()
	for id, enemy in enemies do
		enemies[id] = nil
		enemy.model:Destroy()
	end
	aliveCount = 0
end

function EnemyService.aliveCount(): number
	return aliveCount
end

-- Registra uma funcao chamada quando um inimigo sai (Killed ou Leaked).
-- Devolve uma funcao para cancelar.
function EnemyService.onEnemyRemoved(callback: RemovedCallback): () -> ()
	table.insert(removedListeners, callback)
	return function()
		local index = table.find(removedListeners, callback)
		if index then
			table.remove(removedListeners, index)
		end
	end
end

-- Confere quem chegou ao fim do caminho.
local function checkLeaks()
	local total = PathService.getPathData().total
	local now = workspace:GetServerTimeNow()

	-- Primeiro juntamos os ids; so depois removemos (nao mexer na tabela enquanto percorre).
	table.clear(leakedBuffer)
	for id, enemy in enemies do
		if currentDistance(enemy, now) >= total then
			table.insert(leakedBuffer, id)
		end
	end

	for _, id in leakedBuffer do
		local enemy = enemies[id]
		if enemy then
			fireDied(id, "Leaked", centerPosition(enemy, total), 0)
			BaseService.damage(enemy.baseDamage)
			remove(id, "Leaked")
		end
	end
end

function EnemyService.start()
	if tickConnection then
		return
	end
	-- Acumula o tempo do Heartbeat e roda a conferencia 10x por segundo.
	local interval = 1 / Config.SERVER_TICK_RATE
	local accumulated = 0
	tickConnection = RunService.Heartbeat:Connect(function(dt: number)
		accumulated += dt
		if accumulated < interval then
			return
		end
		accumulated %= interval
		checkLeaks()
	end)
end

-- Para o loop (nao usado no jogo normal, mas deixa a limpeza explicita).
function EnemyService.stop()
	if tickConnection then
		tickConnection:Disconnect()
		tickConnection = nil
	end
end

return EnemyService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">MatchService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- MatchService: dono da partida. Cria ReplicatedStorage.MatchState (atributos que
-- replicam sozinhos para os clientes) e roda o loop:
-- Waiting -> Intermission -> ondas 1..N -> Victory/Defeat -> espera -> recomeca.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))

local EnemyService = require(script.Parent.EnemyService)
local BaseService = require(script.Parent.BaseService)
local UnitService = require(script.Parent.UnitService)
local EconomyService = require(script.Parent.EconomyService)

local MatchService = {}

local POLL_SECONDS = 0.1 -- espera curta usada para conferir condicoes (barato)

local state: Folder? = nil
local waveStartedRemote: RemoteEvent? = nil
local matchEndedRemote: RemoteEvent? = nil
local cleanups: { () -> () } = {}

local function setAttr(name: string, value: string | number)
	if state then
		state:SetAttribute(name, value)
	end
end

local function setState(name: Types.MatchStateName, endsAt: number)
	setAttr("State", name)
	setAttr("StateEndsAt", endsAt)
end

function MatchService.init()
	local folder = Instance.new("Folder")
	folder.Name = "MatchState"
	folder:SetAttribute("State", "Waiting")
	folder:SetAttribute("Wave", 0)
	folder:SetAttribute("WaveCount", #Config.WAVES)
	folder:SetAttribute("BaseHealth", BaseService.getHealth())
	folder:SetAttribute("BaseMaxHealth", Config.BASE_MAX_HEALTH)
	folder:SetAttribute("StateEndsAt", 0)
	folder:SetAttribute("EnemiesAlive", 0)
	folder.Parent = ReplicatedStorage
	state = folder

	waveStartedRemote = Net.event("WaveStarted")
	matchEndedRemote = Net.event("MatchEnded")

	-- Copia a vida da base e a contagem de inimigos para os atributos.
	table.insert(
		cleanups,
		BaseService.onChanged(function(health: number, maxHealth: number)
			setAttr("BaseHealth", health)
			setAttr("BaseMaxHealth", maxHealth)
		end)
	)
	table.insert(
		cleanups,
		EnemyService.onEnemyRemoved(function()
			setAttr("EnemiesAlive", EnemyService.aliveCount())
		end)
	)
end

-- Espera ate existir pelo menos 1 jogador (a partida nao gasta ondas sem ninguem olhando).
local function waitForPlayers()
	while #Players:GetPlayers() < 1 do
		task.wait(0.5)
	end
end

-- Spawna os grupos da onda em sequencia. Para cedo se a base cair.
local function spawnWave(wave: Types.WaveDef)
	for _, group in wave.groups do
		for _ = 1, group.count do
			if BaseService.isDead() then
				return
			end
			-- Se o limite de inimigos vivos for atingido, spawn devolve nil: so pulamos.
			EnemyService.spawn(group.kind)
			setAttr("EnemiesAlive", EnemyService.aliveCount())
			task.wait(group.interval)
		end
	end
end

local function endMatch(result: Types.MatchResult)
	setState(result, workspace:GetServerTimeNow() + Config.RESTART_DELAY_SECONDS)
	if result == "Defeat" then
		EnemyService.clearAll()
		setAttr("EnemiesAlive", 0)
	end
	if matchEndedRemote then
		matchEndedRemote:FireAllClients(result)
	end
end

-- Roda uma partida completa. Devolve "Victory" ou "Defeat".
local function runMatch(): Types.MatchResult
	-- Intermission: contagem regressiva antes da onda 1.
	local endsAt = workspace:GetServerTimeNow() + Config.INTERMISSION_SECONDS
	setState("Intermission", endsAt)
	while workspace:GetServerTimeNow() < endsAt do
		task.wait(POLL_SECONDS)
	end

	local waveCount = #Config.WAVES
	for index, wave in Config.WAVES do
		setAttr("Wave", index)
		setState("Wave", 0) -- onda nao tem hora certa para acabar
		if waveStartedRemote then
			waveStartedRemote:FireAllClients(index, waveCount, wave.boss == true)
		end

		local waveStart = os.clock()
		spawnWave(wave)

		-- A proxima onda comeca quando: terminou de spawnar E (todos sumiram OU deu o tempo).
		-- Na ultima onda esperamos todos sumirem (nao existe "proxima" para adiantar).
		local isLast = index == waveCount
		while not BaseService.isDead() do
			if EnemyService.aliveCount() == 0 then
				break
			end
			if not isLast and os.clock() - waveStart >= Config.WAVE_TIMEOUT_SECONDS then
				break
			end
			task.wait(POLL_SECONDS)
		end

		if BaseService.isDead() then
			return "Defeat"
		end
	end

	return "Victory"
end

function MatchService.start()
	while true do
		setState("Waiting", 0)
		waitForPlayers()

		local result = runMatch()
		endMatch(result)
		task.wait(Config.RESTART_DELAY_SECONDS)

		-- Reinicia tudo para a proxima partida.
		EnemyService.clearAll()
		UnitService.clearAll() -- unidades somem e os slots ficam livres
		EconomyService.resetAll() -- todo mundo volta para START_CASH
		BaseService.reset()
		setAttr("Wave", 0)
		setAttr("EnemiesAlive", 0)
	end
end

-- Limpeza explicita das conexoes (nao e chamada no jogo normal).
function MatchService.destroy()
	for _, cleanup in cleanups do
		cleanup()
	end
	table.clear(cleanups)
end

return MatchService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000011">
					<Properties>
						<string name="Name">PathPreview</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- PathPreview: um cubo de teste que anda pelo caminho em loop.
-- Serve para PROVAR que os waypoints formam um caminho correto.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PathMath = require(Shared:WaitForChild("Util"):WaitForChild("PathMath"))
-- Modulos sao "cacheados": este e o MESMO PathService que o servidor ja iniciou.
local PathService = require(script.Parent.PathService)

local PathPreview = {}

local connection: RBXScriptConnection? = nil

function PathPreview.init() end

function PathPreview.start()
	if not Config.PATH_PREVIEW_ENABLED then
		return
	end

	-- Sobe os pontos para a altura do cubo (feito uma vez, nao todo frame).
	local points: { Vector3 } = {}
	for i, p in PathService.getWaypoints() do
		points[i] = Vector3.new(p.X, Config.PATH_PREVIEW_HEIGHT, p.Z)
	end
	local data = PathMath.build(points)
	if data.total <= 0 then
		warn("PathPreview: caminho com tamanho zero, cubo desligado")
		return
	end

	-- Pasta "Debug" guarda coisas de teste, longe do mapa.
	local existing = workspace:FindFirstChild("Debug")
	local debugFolder: Instance
	if existing then
		debugFolder = existing
	else
		local folder = Instance.new("Folder")
		folder.Name = "Debug"
		folder.Parent = workspace
		debugFolder = folder
	end

	local cube = Instance.new("Part")
	cube.Name = "PathPreviewCube"
	cube.Size = Vector3.one * Config.PATH_PREVIEW_CUBE_SIZE
	cube.Material = Enum.Material.Neon
	cube.Color = Color3.fromRGB(255, 51, 153) -- rosa
	cube.Anchored = true -- sem fisica: nos movemos o cubo na mao
	cube.CanCollide = false
	cube.Position = points[1]

	-- Contorno ciano para o cubo aparecer bem de longe.
	local outline = Instance.new("Highlight")
	outline.FillTransparency = 1
	outline.OutlineColor = Color3.fromRGB(0, 240, 255)
	outline.Parent = cube

	cube.Parent = debugFolder

	-- Variaveis fora da funcao do Heartbeat: nada novo e criado a cada frame.
	local distance = 0
	local speed = Config.PATH_PREVIEW_SPEED
	local total = data.total

	-- ATENCAO: isto e so uma ferramenta de teste. Mover pecas no servidor a cada frame
	-- manda ~60 atualizacoes por segundo pra cada jogador. Nos inimigos de verdade
	-- (semana 2) o servidor guarda so a distancia e o cliente desenha o movimento.
	connection = RunService.Heartbeat:Connect(function(dt: number)
		-- Anda um pouco; ao passar do fim, volta ao comeco (loop).
		distance = (distance + speed * dt) % total
		cube.Position = PathMath.positionAt(data, distance)
	end)

	-- Se o cubo for destruido, solta a conexao (evita vazamento de memoria).
	cube.Destroying:Once(function()
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end)
end

return PathPreview
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000012">
					<Properties>
						<string name="Name">PathService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- PathService: le os waypoints do mapa (Workspace.Map.Waypoints) e guarda a lista.
-- Os outros sistemas pedem o caminho aqui, em vez de cada um ler o mapa por conta propria.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PathMath = require(Shared:WaitForChild("Util"):WaitForChild("PathMath"))
local Types = require(Shared:WaitForChild("Types"))

local PathService = {}

local waypoints: { Vector3 } = {}
local pathData: Types.PathData? = nil

type Entry = { index: number, position: Vector3 }

function PathService.init()
	-- O mapa ja vem pronto no arquivo do jogo, entao FindFirstChild basta (init nao pode esperar).
	local map = workspace:FindFirstChild("Map")
	assert(map, "PathService: nao achei workspace.Map (o mapa foi construido pelo Rojo?)")
	local folder = map:FindFirstChild("Waypoints")
	assert(folder, "PathService: nao achei workspace.Map.Waypoints")

	local entries: { Entry } = {}
	for _, child in folder:GetChildren() do
		assert(child:IsA("BasePart"), `PathService: "{child.Name}" em Waypoints nao e uma Part`)
		local index = child:GetAttribute("Index")
		assert(typeof(index) == "number", `PathService: waypoint "{child.Name}" sem atributo numerico Index`)
		table.insert(entries, { index = index, position = child.Position })
	end

	assert(#entries >= 2, `PathService: preciso de pelo menos 2 waypoints, achei {#entries}`)

	-- A ordem dos filhos nao e garantida, entao ordenamos pelo atributo Index.
	table.sort(entries, function(a: Entry, b: Entry)
		return a.index < b.index
	end)

	-- Valida: Index tem que ser 1, 2, 3... sem buracos e sem repetidos.
	local list: { Vector3 } = {}
	for i, entry in entries do
		assert(entry.index == i, `PathService: Index esperado {i} mas achei {entry.index} (buraco ou repetido)`)
		list[i] = entry.position
	end

	waypoints = list

	-- Publica os pontos em ReplicatedStorage.PathPoints para os clientes.
	-- O cliente monta o caminho a partir daqui (o Workspace pode "sumir" com streaming).
	-- Y = 0: nivel do chao (o inimigo soma o proprio HeightOffset depois).
	local old = ReplicatedStorage:FindFirstChild("PathPoints")
	if old then
		old:Destroy()
	end
	local pointsFolder = Instance.new("Folder")
	pointsFolder.Name = "PathPoints"
	for i, p in list do
		local value = Instance.new("Vector3Value")
		value.Name = tostring(i)
		value.Value = Vector3.new(p.X, 0, p.Z)
		value.Parent = pointsFolder
	end
	pointsFolder.Parent = ReplicatedStorage

	-- Calcula os dados do caminho uma vez so e guarda (cache).
	pathData = nil
	PathService.getPathData()
end

-- Devolve uma COPIA, assim ninguem estraga a lista original sem querer.
function PathService.getWaypoints(): { Vector3 }
	return table.clone(waypoints)
end

-- Dados prontos do caminho (comprimentos, total) no nivel do chao (Y = 0).
-- Construido uma vez com PathMath.build; depois so devolve o cache.
function PathService.getPathData(): Types.PathData
	local cached = pathData
	if cached then
		return cached
	end
	local flat: { Vector3 } = {}
	for i, p in waypoints do
		flat[i] = Vector3.new(p.X, 0, p.Z)
	end
	local built = PathMath.build(flat)
	pathData = built
	return built
end

return PathService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000013">
					<Properties>
						<string name="Name">UnitService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- UnitService: unidades (torres) dos jogadores.
-- Faz: validar PlaceUnit, criar o visual, marcar slots e rodar o combate a 10 Hz.
-- Unidades nunca se movem. O servidor decide TUDO (dano, alvo, dinheiro);
-- o cliente so recebe eventos para desenhar os efeitos.
-- Este modulo NAO pode dar require no MatchService (evita require circular):
-- o estado da partida e lido direto do atributo ReplicatedStorage.MatchState.State.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Types = require(Shared:WaitForChild("Types"))

local EnemyService = require(script.Parent.EnemyService)
local EconomyService = require(script.Parent.EconomyService)
local PathService = require(script.Parent.PathService)

local UnitService = {}

local MAX_NAME_LENGTH = 16
local RATE_PER_SECOND = 4 -- maximo de PlaceUnit por segundo por jogador
local BURST = 4
local PEDESTAL_HEIGHT = 0.3

type Unit = {
	id: string,
	kind: string,
	def: Types.UnitDef,
	owner: Player,
	slotName: string,
	model: Model,
	position: Vector3, -- pe da unidade (usado no alcance, plano XZ)
	muzzle: Vector3, -- de onde sai o ataque
	nextAttack: number, -- os.clock() em que pode atacar de novo
}

type Bucket = { tokens: number, last: number }

local units: { [string]: Unit } = {} -- por id (nunca varremos o workspace)
local slotUnit: { [string]: string } = {} -- nome do slot -> id da unidade que ocupa
local unitCount: { [Player]: number } = {} -- quantas unidades cada jogador tem
local buckets: { [Player]: Bucket } = {}
local slots: { [string]: BasePart } = {} -- cache dos slots (lidos uma vez no init)
local placementFolder: Instance? = nil
local container: Folder? = nil
local nextId = 0

local placeRemote: RemoteEvent? = nil
local placedRemote: RemoteEvent? = nil
local attackedRemote: RemoteEvent? = nil
local notifyRemote: RemoteEvent? = nil

local connections: { RBXScriptConnection } = {}
local cleanups: { () -> () } = {}
local tickConnection: RBXScriptConnection? = nil

-- Ids de inimigos mortos neste tick (o retrato do EnemyService nao sabe que morreram).
local deadThisTick: { [string]: boolean } = {}

local function notify(player: Player, text: string)
	if notifyRemote then
		notifyRemote:FireClient(player, text)
	end
end

-- "Balde de fichas": cada PlaceUnit gasta 1 ficha; as fichas voltam com o tempo.
local function allow(player: Player): boolean
	local now = os.clock()
	local bucket = buckets[player]
	if not bucket then
		bucket = { tokens = BURST, last = now }
		buckets[player] = bucket
	end
	bucket.tokens = math.min(BURST, bucket.tokens + (now - bucket.last) * RATE_PER_SECOND)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Ponto da estrada (plano XZ) mais perto de "from". A unidade olha para la.
local function nearestRoadPoint(from: Vector3): Vector3
	local data = PathService.getPathData()
	local best = from
	local bestDistSq = math.huge
	for i = 1, #data.points - 1 do
		local a = data.points[i]
		local b = data.points[i + 1]
		local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
		local lenSq = ab.X * ab.X + ab.Z * ab.Z
		local t = 0
		if lenSq > 1e-6 then
			t = math.clamp(((from.X - a.X) * ab.X + (from.Z - a.Z) * ab.Z) / lenSq, 0, 1)
		end
		local point = Vector3.new(a.X + ab.X * t, 0, a.Z + ab.Z * t)
		local dx = point.X - from.X
		local dz = point.Z - from.Z
		local distSq = dx * dx + dz * dz
		if distSq < bestDistSq then
			bestDistSq = distSq
			best = point
		end
	end
	return best
end

-- Peca de enfeite soldada ao Root. offset e relativo ao "baseCFrame" (o chao, ja virado).
local function decorate(
	model: Model,
	root: BasePart,
	baseCFrame: CFrame,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	color: Color3,
	neon: boolean,
	offset: CFrame
)
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CFrame = baseCFrame * offset
	part.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
end

-- Disco achatado (cilindro deitado para ficar "em pe" no eixo Y).
local FLAT = CFrame.Angles(0, 0, math.pi / 2)

-- Monta o visual low-poly. baseCFrame fica no chao (topo do slot), olhando para a estrada.
-- O Root e um pedestal fino no chao; corpo, cabeca e acessorios sao soldados nele.
local function buildModel(id: string, kind: string, def: Types.UnitDef, baseCFrame: CFrame): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Shape = Enum.PartType.Cylinder
	root.Size = Vector3.new(PEDESTAL_HEIGHT, 3.2, 3.2)
	root.Color = def.accentColor
	root.Material = Enum.Material.Neon
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = baseCFrame * CFrame.new(0, PEDESTAL_HEIGHT / 2, 0) * FLAT
	root.Parent = model
	model.PrimaryPart = root

	local h = def.height
	local bodyH = h * 0.45
	local headD = h * 0.28
	local bodyY = PEDESTAL_HEIGHT + bodyH / 2
	local headY = PEDESTAL_HEIGHT + bodyH + headD * 0.45
	local headTop = headY + headD / 2
	local ball = Enum.PartType.Ball
	local block = Enum.PartType.Block
	local cyl = Enum.PartType.Cylinder

	-- Corpo e cabeca (iguais para todos; so a cor muda).
	decorate(model, root, baseCFrame, "Body", block, Vector3.new(2.1, bodyH, 1.5), def.color, false, CFrame.new(0, bodyY, 0))
	decorate(model, root, baseCFrame, "Head", ball, Vector3.new(headD, headD, headD), def.color, false, CFrame.new(0, headY, 0))

	if kind == "Ninja" then
		-- Faixa neon na cabeca + cachecol neon com ponta solta atras (+Z = costas).
		decorate(
			model, root, baseCFrame, "Headband", block,
			Vector3.new(headD * 1.06, 0.25, headD * 1.06), def.accentColor, true,
			CFrame.new(0, headY + headD * 0.1, 0)
		)
		decorate(
			model, root, baseCFrame, "Scarf", block,
			Vector3.new(1.7, 0.35, 1.7), def.accentColor, true,
			CFrame.new(0, PEDESTAL_HEIGHT + bodyH + 0.05, 0)
		)
		decorate(
			model, root, baseCFrame, "ScarfTail", block,
			Vector3.new(0.4, 0.2, 1.4), def.accentColor, true,
			CFrame.new(0.5, PEDESTAL_HEIGHT + bodyH, 1.2) * CFrame.Angles(0.5, 0, 0)
		)
	elseif kind == "Samurai" then
		-- Chapeu largo (disco) + katana neon ao lado.
		decorate(
			model, root, baseCFrame, "Hat", cyl,
			Vector3.new(0.4, headD * 2.3, headD * 2.3), def.color:Lerp(Color3.new(0, 0, 0), 0.35), false,
			CFrame.new(0, headTop - 0.05, 0) * FLAT
		)
		decorate(
			model, root, baseCFrame, "Katana", block,
			Vector3.new(0.18, h * 0.75, 0.18), def.accentColor, true,
			CFrame.new(1.5, PEDESTAL_HEIGHT + bodyH * 0.8, -0.2) * CFrame.Angles(0, 0, -0.25)
		)
	elseif kind == "Mage" then
		-- Chapeu "cone" feito de 3 discos que diminuem + orbe neon flutuando.
		local widths = { headD * 1.9, headD * 1.4, headD * 0.8 }
		for i, width in widths do
			decorate(
				model, root, baseCFrame, "HatPart" .. tostring(i), cyl,
				Vector3.new(0.45, width, width), def.color:Lerp(Color3.new(0, 0, 0), 0.25), false,
				CFrame.new(0, headTop + (i - 1) * 0.42, 0) * FLAT
			)
		end
		decorate(
			model, root, baseCFrame, "Orb", ball,
			Vector3.new(1.1, 1.1, 1.1), def.accentColor, true,
			CFrame.new(1.6, PEDESTAL_HEIGHT + bodyH + 0.6, 0)
		)
	end

	return model, root
end

local function matchStateName(): string?
	local folder = ReplicatedStorage:FindFirstChild("MatchState")
	if not folder then
		return nil
	end
	local value = folder:GetAttribute("State")
	if typeof(value) == "string" then
		return value
	end
	return nil
end

-- Destroi uma unidade e libera o slot dela.
local function removeUnit(unit: Unit)
	units[unit.id] = nil
	if slotUnit[unit.slotName] == unit.id then
		slotUnit[unit.slotName] = nil
		local slot = slots[unit.slotName]
		if slot then
			slot:SetAttribute("Occupied", false)
		end
	end
	local count = unitCount[unit.owner]
	if count then
		unitCount[unit.owner] = math.max(0, count - 1)
	end
	unit.model:Destroy()
end

local function onPlaceUnit(player: Player, kind: unknown, slotName: unknown)
	-- 1. Limite de pedidos (antes de tudo: nem gasta CPU com spam).
	if not allow(player) then
		return
	end
	-- 2. Tipos e tamanhos. Pedido malformado e descartado em silencio (nao ajudamos exploiter).
	if typeof(kind) ~= "string" or typeof(slotName) ~= "string" then
		return
	end
	if #kind > MAX_NAME_LENGTH or #slotName > MAX_NAME_LENGTH then
		return
	end
	-- 3. O tipo existe? O custo vem do Config do SERVIDOR, nunca do cliente.
	local def = Config.UNITS[kind]
	if not def then
		return
	end
	-- 4. A partir daqui o jogador recebe um aviso do motivo.
	local stateName = matchStateName()
	if stateName == nil or not Config.PLACE_ALLOWED_STATES[stateName] then
		notify(player, "Wait for the next round")
		return
	end
	-- 5. O slot existe e e uma Part do mapa?
	local slot = slots[slotName]
	if not slot or slot.Parent ~= placementFolder then
		return
	end
	if slotUnit[slotName] ~= nil or slot:GetAttribute("Occupied") == true then
		notify(player, "Slot taken")
		return
	end
	-- 6. Limite de unidades por jogador.
	local count = unitCount[player] or 0
	if count >= Config.MAX_UNITS_PER_PLAYER then
		notify(player, "Unit limit reached")
		return
	end
	-- 7. Dinheiro: trySpend confere e desconta numa tacada so.
	if not EconomyService.trySpend(player, def.cost) then
		notify(player, "Not enough cash!")
		return
	end

	-- Tudo certo: cria a unidade em cima do slot, virada para a estrada.
	local folder = container
	if not folder then
		return
	end
	nextId += 1
	local id = `U{nextId}`
	local ground = Vector3.new(slot.Position.X, slot.Position.Y + slot.Size.Y / 2, slot.Position.Z)
	local roadPoint = nearestRoadPoint(ground)
	local lookTarget = Vector3.new(roadPoint.X, ground.Y, roadPoint.Z)
	local baseCFrame = CFrame.new(ground)
	if (lookTarget - ground).Magnitude > 1e-3 then
		baseCFrame = CFrame.lookAt(ground, lookTarget)
	end

	local model, root = buildModel(id, kind, def, baseCFrame)
	-- Atributos ANTES de parentar: o cliente ja ve tudo certo quando o modelo aparece.
	model:SetAttribute("Id", id)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("Slot", slotName)
	model.Parent = folder

	slot:SetAttribute("Occupied", true)
	slotUnit[slotName] = id
	unitCount[player] = count + 1
	units[id] = {
		id = id,
		kind = kind,
		def = def,
		owner = player,
		slotName = slotName,
		model = model,
		position = ground,
		muzzle = root.Position + Vector3.yAxis * def.height * 0.7,
		nextAttack = 0,
	}

	if placedRemote then
		placedRemote:FireAllClients(id, kind, ground, player.UserId)
	end
end

local function dist2dSq(a: Vector3, b: Vector3): number
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return dx * dx + dz * dz
end

-- Um tick de combate: cada unidade pronta escolhe o inimigo mais avancado no alcance.
local function combatTick()
	if next(units) == nil then
		return
	end
	local list, count = EnemyService.snapshot() -- UMA vez por tick
	if count == 0 then
		return
	end
	table.clear(deadThisTick)
	local now = os.clock()

	for _, unit in units do
		if now < unit.nextAttack then
			continue
		end
		local def = unit.def
		local rangeSq = def.range * def.range

		-- Alvo = "first": o inimigo com MAIOR distancia andada que esta no alcance.
		local target: Types.SnapshotEntry? = nil
		local bestDistance = -1
		for i = 1, count do
			local enemy = list[i]
			if
				not deadThisTick[enemy.id]
				and enemy.distance > bestDistance
				and dist2dSq(enemy.position, unit.position) <= rangeSq
			then
				target = enemy
				bestDistance = enemy.distance
			end
		end
		if not target then
			continue
		end

		unit.nextAttack = now + def.cooldown
		local targetPosition = target.position
		local targetId = target.id
		EnemyService.damage(targetId, def.damage)

		-- Dano em area: todo outro inimigo perto do ponto atingido.
		if def.splashRadius > 0 then
			local splashSq = def.splashRadius * def.splashRadius
			for i = 1, count do
				local other = list[i]
				if
					other.id ~= targetId
					and not deadThisTick[other.id]
					and dist2dSq(other.position, targetPosition) <= splashSq
				then
					EnemyService.damage(other.id, def.damage)
				end
			end
		end

		-- UM evento por ataque (o cliente desenha a area se for splash).
		if attackedRemote then
			attackedRemote:FireAllClients(unit.id, unit.kind, unit.muzzle, targetPosition)
		end
	end
end

function UnitService.init()
	local folder = Instance.new("Folder")
	folder.Name = "Units"
	folder.Parent = workspace
	container = folder

	-- Le os slots UMA vez (o mapa ja vem pronto; init nao pode esperar/yieldar).
	local map = workspace:FindFirstChild("Map")
	assert(map, "UnitService: nao achei workspace.Map")
	local placement = map:FindFirstChild("Placement")
	assert(placement, "UnitService: nao achei workspace.Map.Placement")
	placementFolder = placement
	for _, child in placement:GetChildren() do
		if child:IsA("BasePart") then
			slots[child.Name] = child
			child:SetAttribute("Occupied", false)
		end
	end

	placeRemote = Net.event("PlaceUnit")
	placedRemote = Net.event("UnitPlaced")
	attackedRemote = Net.event("UnitAttacked")
	notifyRemote = Net.event("Notify")

	if placeRemote then
		table.insert(connections, placeRemote.OnServerEvent:Connect(onPlaceUnit))
	end

	-- Jogador saiu: some com as unidades dele (senao o slot ficaria preso) e com o balde.
	table.insert(
		connections,
		Players.PlayerRemoving:Connect(function(player: Player)
			local mine: { Unit } = {}
			for _, unit in units do
				if unit.owner == player then
					table.insert(mine, unit)
				end
			end
			for _, unit in mine do
				removeUnit(unit)
			end
			unitCount[player] = nil
			buckets[player] = nil
		end)
	)

	-- Quem morreu neste tick nao pode ser alvo de outra unidade.
	table.insert(
		cleanups,
		EnemyService.onEnemyRemoved(function(id: string, reason: Types.DeathReason)
			if reason == "Killed" then
				deadThisTick[id] = true
			end
		end)
	)
end

function UnitService.start()
	if tickConnection then
		return
	end
	-- Acumula o tempo do Heartbeat e roda o combate 10x por segundo.
	local interval = 1 / Config.SERVER_TICK_RATE
	local accumulated = 0
	tickConnection = RunService.Heartbeat:Connect(function(dt: number)
		accumulated += dt
		if accumulated < interval then
			return
		end
		accumulated %= interval
		combatTick()
	end)
end

-- Apaga todas as unidades, libera os slots e zera as contagens (sem eventos).
function UnitService.clearAll()
	for _, unit in units do
		unit.model:Destroy()
	end
	table.clear(units)
	table.clear(slotUnit)
	table.clear(unitCount)
	for _, slot in slots do
		slot:SetAttribute("Occupied", false)
	end
end

function UnitService.countOf(player: Player): number
	return unitCount[player] or 0
end

-- Limpeza explicita (nao usada no jogo normal).
function UnitService.destroy()
	if tickConnection then
		tickConnection:Disconnect()
		tickConnection = nil
	end
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, cleanup in cleanups do
		cleanup()
	end
	table.clear(cleanups)
	table.clear(buckets)
end

return UnitService
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000014">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000015">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX00000016">
				<Properties>
					<string name="Name">Client</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Ponto de entrada do cliente: o UNICO LocalScript.
-- Mesma ideia do servidor: init() de todos os Controllers, depois start().

local Controllers = script:WaitForChild("Controllers")

local loaded: { any } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		table.insert(loaded, require(child))
	end
end

for _, controller in loaded do
	if typeof(controller.init) == "function" then
		controller.init()
	end
end

for _, controller in loaded do
	if typeof(controller.start) == "function" then
		task.spawn(controller.start)
	end
end
]]></ProtectedString>
				</Properties>
				<Item class="Folder" referent="RBX00000017">
					<Properties>
						<string name="Name">Controllers</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX00000018">
						<Properties>
							<string name="Name">DebugController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- DebugController: SO no Studio. Clicar (ou tocar) num inimigo causa dano de teste,
-- para podermos ver confete e recompensas sem ter torres ainda.
-- O cliente so manda "cliquei no inimigo X"; o servidor valida e decide o dano.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local RAY_LENGTH = 1000
local MIN_CLICK_INTERVAL = 0.1 -- no maximo 10 cliques por segundo (o servidor tambem limita)

local DebugController = {}

local connections: { RBXScriptConnection } = {}

function DebugController.init() end

function DebugController.start()
	-- Fora do Studio este controller nao faz nada (nem cria o remote nem a interface).
	if not RunService:IsStudio() then
		return
	end

	local enemiesInst = workspace:WaitForChild("Enemies", 30)
	if not enemiesInst then
		warn("[DebugController] workspace.Enemies nao apareceu em 30s.")
		return
	end
	local enemies: Instance = enemiesInst
	local hitRemote = Net.event("DebugHitEnemy")

	-- Etiqueta pequena no canto inferior esquerdo.
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "DebugGui"
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0, 1)
	label.Position = UDim2.fromScale(0.01, 0.99)
	label.Size = UDim2.fromScale(0.2, 0.035)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 225, 60)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = "DEBUG: click enemies"
	label.Parent = gui

	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 12
	limit.MaxTextSize = 18
	limit.Parent = label

	-- O raio so enxerga coisas dentro de workspace.Enemies (ignora mapa e jogadores).
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { enemies }

	local lastClick = 0

	table.insert(
		connections,
		UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
			if gameProcessed then
				return -- clique em botao/interface nao conta
			end
			local inputType = input.UserInputType
			if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
				return
			end

			local now = os.clock()
			if now - lastClick < MIN_CLICK_INTERVAL then
				return
			end

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			-- ScreenPointToRay ja considera a barra superior do Roblox (inset).
			local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
			local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
			if not result then
				return
			end

			local model = result.Instance:FindFirstAncestorOfClass("Model")
			if model and model.Parent == enemies then
				lastClick = now
				hitRemote:FireServer(model.Name)
			end
		end)
	)
end

function DebugController.destroy()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

return DebugController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000019">
						<Properties>
							<string name="Name">EnemyRenderer</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- EnemyRenderer: move os inimigos NA TELA de cada jogador.
-- O servidor nao move inimigos todo frame. Cada inimigo guarda BaseDistance, BaseTime e Speed,
-- e a distancia agora e: BaseDistance + Speed * (agora - BaseTime).
-- Aqui, todo frame, calculamos isso e movemos a copia local do modelo com PivotTo.
-- Tambem desenhamos a barra de vida e um flash branco quando o inimigo leva dano.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

-- WaitForChild: no cliente, as pastas podem chegar um pouco depois do script rodar.
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local PathMath = require(Shared:WaitForChild("Util"):WaitForChild("PathMath"))
local EnemyMath = require(Shared:WaitForChild("Util"):WaitForChild("EnemyMath"))

local BOB_SPEED = 6 -- velocidade do balanco (radianos por segundo)
local BOB_HEIGHT = 0.35 -- altura do balanco em studs
local BAR_COLOR_LOW = Color3.fromRGB(255, 50, 70)
local BAR_COLOR_HIGH = Color3.fromRGB(120, 255, 90)
local BAR_BACK_COLOR = Color3.fromRGB(20, 12, 40)
local FILL_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FLASH_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Tudo que sabemos de um inimigo fica numa tabela so (evita procurar atributos todo frame).
type Entry = {
	model: Model,
	root: BasePart?,
	baseDistance: number,
	baseTime: number,
	speed: number,
	heightOffset: number,
	phase: number, -- cada inimigo balanca em um ritmo diferente
	health: number,
	maxHealth: number,
	billboard: BillboardGui?,
	fill: Frame?,
	highlight: Highlight?,
	flashTween: Tween?,
	fillTween: Tween?,
	connections: { RBXScriptConnection },
	alive: boolean,
}

local EnemyRenderer = {}

local entries: { [Model]: Entry } = {}
local pathData: Types.PathData? = nil
local globalConnections: { RBXScriptConnection } = {}

local function getNumber(inst: Instance, name: string, default: number): number
	local value = inst:GetAttribute(name)
	if typeof(value) == "number" then
		return value
	end
	return default
end

local function readMotion(entry: Entry)
	local model = entry.model
	entry.baseDistance = getNumber(model, "BaseDistance", 0)
	entry.baseTime = getNumber(model, "BaseTime", workspace:GetServerTimeNow())
	entry.speed = getNumber(model, "Speed", 0)
	entry.heightOffset = getNumber(model, "HeightOffset", 0)
end

-- Cria o flash branco (Highlight) so na primeira vez que o inimigo leva dano.
local function flash(entry: Entry)
	local highlight = entry.highlight
	if not highlight then
		local created = Instance.new("Highlight")
		created.Name = "HitFlash"
		created.Adornee = entry.model
		created.FillColor = Color3.new(1, 1, 1)
		created.FillTransparency = 1
		created.OutlineTransparency = 1
		created.Enabled = false
		created.Parent = entry.model
		entry.highlight = created
		highlight = created
	end

	local old = entry.flashTween
	if old then
		old:Cancel()
	end
	highlight.Enabled = true
	highlight.FillTransparency = 0.15
	local tween = TweenService:Create(highlight, FLASH_INFO, { FillTransparency = 1 })
	entry.flashTween = tween
	local shown = highlight
	tween.Completed:Once(function()
		-- So desliga se ainda for o nosso tween (outro flash pode ter comecado).
		if entry.alive and entry.flashTween == tween then
			shown.Enabled = false
		end
	end)
	tween:Play()
end

local function updateHealth(entry: Entry, animate: boolean)
	local newHealth = getNumber(entry.model, "Health", entry.health)
	local maxHealth = math.max(1, getNumber(entry.model, "MaxHealth", entry.maxHealth))
	local tookDamage = newHealth < entry.health
	entry.health = newHealth
	entry.maxHealth = maxHealth

	local ratio = math.clamp(newHealth / maxHealth, 0, 1)
	local billboard = entry.billboard
	local fill = entry.fill
	if billboard and fill then
		-- A barra so aparece depois do primeiro dano (menos coisa na tela).
		billboard.Enabled = ratio < 1 and ratio > 0
		local goal = {
			Size = UDim2.fromScale(ratio, 1),
			BackgroundColor3 = BAR_COLOR_LOW:Lerp(BAR_COLOR_HIGH, ratio),
		}
		local old = entry.fillTween
		if old then
			old:Cancel()
		end
		if animate then
			local tween = TweenService:Create(fill, FILL_INFO, goal)
			entry.fillTween = tween
			tween:Play()
		else
			fill.Size = goal.Size
			fill.BackgroundColor3 = goal.BackgroundColor3
		end
	end

	if tookDamage and animate then
		flash(entry)
	end
end

-- Monta a barra de vida (BillboardGui) em cima do inimigo. Tamanho em studs (Scale).
local function buildBar(entry: Entry, root: BasePart)
	local width = math.clamp(root.Size.X * 1.3, 3, 8)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthBar"
	billboard.Adornee = root
	billboard.Size = UDim2.fromScale(width, 0.55)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, root.Size.Y / 2 + 1.5, 0)
	billboard.MaxDistance = 120 -- longe demais nao precisa desenhar
	billboard.AlwaysOnTop = false
	billboard.Active = false
	billboard.Enabled = false
	billboard.Parent = root

	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = BAR_BACK_COLOR
	back.BorderSizePixel = 0
	back.Parent = billboard

	local backCorner = Instance.new("UICorner")
	backCorner.CornerRadius = UDim.new(0.5, 0)
	backCorner.Parent = back

	local backStroke = Instance.new("UIStroke")
	backStroke.Color = Color3.new(1, 1, 1)
	backStroke.Thickness = 1
	backStroke.Parent = back

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = BAR_COLOR_HIGH
	fill.BorderSizePixel = 0
	fill.Parent = back

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	entry.billboard = billboard
	entry.fill = fill
	updateHealth(entry, false)
end

local function track(model: Model)
	if entries[model] then
		return
	end

	local entry: Entry = {
		model = model,
		root = nil,
		baseDistance = 0,
		baseTime = workspace:GetServerTimeNow(),
		speed = 0,
		heightOffset = 0,
		phase = math.random() * math.pi * 2,
		health = getNumber(model, "Health", 1),
		maxHealth = getNumber(model, "MaxHealth", 1),
		billboard = nil,
		fill = nil,
		highlight = nil,
		flashTween = nil,
		fillTween = nil,
		connections = {},
		alive = true,
	}
	entries[model] = entry
	readMotion(entry)

	-- Um unico listener de atributos por inimigo: vida OU movimento (ex.: lentidao = "rebase").
	table.insert(
		entry.connections,
		model.AttributeChanged:Connect(function(name: string)
			if name == "Health" or name == "MaxHealth" then
				updateHealth(entry, true)
			else
				readMotion(entry)
			end
		end)
	)

	-- O Root pode demorar para chegar (streaming), entao esperamos sem travar o resto.
	task.spawn(function()
		local rootInst = model:WaitForChild("Root", 10)
		if not entry.alive then
			return
		end
		if rootInst and rootInst:IsA("BasePart") then
			entry.root = rootInst
			buildBar(entry, rootInst)
		end
	end)
end

local function untrack(model: Model)
	local entry = entries[model]
	if not entry then
		return
	end
	entry.alive = false
	entries[model] = nil

	for _, connection in entry.connections do
		connection:Disconnect()
	end
	table.clear(entry.connections)

	if entry.flashTween then
		entry.flashTween:Cancel()
	end
	if entry.fillTween then
		entry.fillTween:Cancel()
	end
	-- O modelo pode so ter saido do streaming (nao destruido): limpamos o que criamos.
	if entry.billboard then
		entry.billboard:Destroy()
	end
	if entry.highlight then
		entry.highlight:Destroy()
	end
end

-- Roda todo frame. Nada de criar tabelas aqui (so numeros e Vector3/CFrame).
local function onRenderStep()
	local data = pathData
	if not data then
		return
	end
	local now = workspace:GetServerTimeNow()
	local clock = os.clock()
	for _, entry in entries do
		if entry.root then
			local distance = EnemyMath.distanceAt(entry.baseDistance, entry.baseTime, entry.speed, now)
			-- (sin * 0.5 + 0.5) vai de 0 a 1: o inimigo so sobe, nunca afunda no chao.
			-- O 0.1 extra deixa ele acima da estrada (que tem 0.1 de altura).
			local bob = 0.1 + (math.sin(clock * BOB_SPEED + entry.phase) * 0.5 + 0.5) * BOB_HEIGHT
			local position = PathMath.positionAt(data, distance) + Vector3.new(0, entry.heightOffset + bob, 0)
			local direction = PathMath.directionAt(data, distance)
			entry.model:PivotTo(CFrame.lookAt(position, position + direction))
		end
	end
end

function EnemyRenderer.init() end

function EnemyRenderer.start()
	-- 1) Caminho: montado a partir da pasta replicada (nunca do workspace, que pode "sumir").
	local pointsFolder = ReplicatedStorage:WaitForChild("PathPoints", 30)
	if not pointsFolder then
		warn("[EnemyRenderer] PathPoints nao apareceu em 30s.")
		return
	end

	local indexed: { { index: number, position: Vector3 } } = {}
	for _, child in pointsFolder:GetChildren() do
		local index = tonumber(child.Name)
		if index and child:IsA("Vector3Value") then
			table.insert(indexed, { index = index, position = child.Value })
		end
	end
	table.sort(indexed, function(a, b)
		return a.index < b.index
	end)
	local points: { Vector3 } = {}
	for _, item in indexed do
		table.insert(points, item.position)
	end
	if #points < 2 then
		warn("[EnemyRenderer] caminho com menos de 2 pontos.")
		return
	end
	pathData = PathMath.build(points)

	-- 2) Inimigos: os que ja existem + os que chegarem/sairem depois.
	local enemiesInst = workspace:WaitForChild("Enemies", 30)
	if not enemiesInst then
		warn("[EnemyRenderer] workspace.Enemies nao apareceu em 30s.")
		return
	end

	table.insert(
		globalConnections,
		enemiesInst.ChildAdded:Connect(function(child: Instance)
			if child:IsA("Model") then
				track(child)
			end
		end)
	)
	table.insert(
		globalConnections,
		enemiesInst.ChildRemoved:Connect(function(child: Instance)
			if child:IsA("Model") then
				untrack(child)
			end
		end)
	)
	for _, child in enemiesInst:GetChildren() do
		if child:IsA("Model") then
			track(child)
		end
	end

	table.insert(globalConnections, RunService.RenderStepped:Connect(onRenderStep))
end

-- Desliga tudo (nao usado no jogo normal, mas deixa a limpeza explicita).
function EnemyRenderer.destroy()
	for _, connection in globalConnections do
		connection:Disconnect()
	end
	table.clear(globalConnections)
	for model in entries do
		untrack(model)
	end
end

return EnemyRenderer
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001A">
						<Properties>
							<string name="Name">FxController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- FxController: o "suco" do jogo! Confete, numeros flutuantes, banners, tremor de camera.
-- Tudo roda so no cliente e so DESENHA: quem decide o que aconteceu e o servidor (via remotes).
-- Para ficar leve no celular: usamos POOLS (objetos criados uma vez e reaproveitados),
-- limites de quantidade e nada de criar objetos a cada frame.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
-- Config como "any": Config.UNITS pode ainda nao existir; lemos com cuidado e usamos cores reserva.
local Config = require(Shared:WaitForChild("Config")) :: any

-- Paleta neon (rosa, ciano, amarelo, lima, roxo).
local PALETTE: { Color3 } = {
	Color3.fromRGB(255, 51, 153),
	Color3.fromRGB(0, 240, 255),
	Color3.fromRGB(255, 225, 60),
	Color3.fromRGB(120, 255, 90),
	Color3.fromRGB(170, 80, 255),
}
local RED = Color3.fromRGB(255, 50, 70)
local GOLD = Color3.fromRGB(255, 200, 40)
local DARK = Color3.fromRGB(20, 12, 40)

-- Limites e ajustes (mexa aqui para deixar mais ou menos intenso).
local BURST_POOL_SIZE = 8 -- explosoes de confete ao mesmo tempo
local LEAK_POOL_SIZE = 4
local NUMBER_POOL_SIZE = 20 -- numeros flutuantes ao mesmo tempo (limite do spec)
local CONFETTI_PER_COLOR = 6 -- 5 cores x 6 = 30 pedacinhos por explosao
local VICTORY_PIECES = 50
local SOUND_ENABLED = true
local SOUND_ID = "rbxasset://sounds/electronicpingshort.wav"
local SHAKE_BIND_NAME = "TokyoBurstCameraShake"

-- Limites dos efeitos das unidades (semana 3).
local PROJECTILE_POOL_SIZE = 40 -- maximo de projeteis ao mesmo tempo (se lotar, ignora o novo)
local SPARK_POOL_SIZE = 12
local RING_POOL_SIZE = 8
local PLACE_POOL_SIZE = 4
local STYLE_SHURIKEN = 1 -- numeros em vez de textos: comparar numero e mais barato no loop
local STYLE_SLASH = 2
local STYLE_ORB = 3
local HIDDEN_POSITION = Vector3.new(0, -500, 0)

-- Animacoes reaproveitadas.
local POP_IN = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local NUMBER_POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local NUMBER_RISE = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local NUMBER_FADE = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.5)
local BANNER_FADE = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local FLASH_FADE = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local LIGHT_FADE = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local GRADE_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

type BurstSlot = {
	part: Part,
	emitters: { ParticleEmitter },
	light: PointLight,
	lightTween: Tween?,
}

type NumberSlot = {
	part: Part,
	gui: BillboardGui,
	label: TextLabel,
	scale: UIScale,
	stroke: UIStroke,
	token: number, -- sobe a cada uso; tweens antigos conferem o token antes de agir
	tweens: { Tween },
}

type UnitVisual = {
	style: number,
	color: Color3,
	accent: Color3,
	splash: number,
	height: number,
}

type ProjectileSlot = {
	part: Part,
	aux: Part, -- segunda peca: cruz da shuriken, nucleo branco do slash, brilho do orb
	active: boolean,
	style: number,
	t: number,
	duration: number,
	from: Vector3,
	to: Vector3,
	base: CFrame,
	arc: number,
	visual: UnitVisual,
}

type SparkSlot = {
	part: Part,
	emitter: ParticleEmitter,
	light: PointLight,
	lightTween: Tween?,
}

type RingSlot = {
	part: Part,
	tweens: { Tween },
}

type PlaceSlot = {
	sphere: Part,
	pillar: Part,
	ring: RingSlot,
	light: PointLight,
	tweens: { Tween },
}

local FxController = {}

local connections: { RBXScriptConnection } = {}

local fxFolder: Folder? = nil
local burstSlots: { BurstSlot } = {}
local leakSlots: { BurstSlot } = {}
local numberSlots: { NumberSlot } = {}
local nextBurst = 1
local nextLeak = 1
local nextNumber = 1

local projectileSlots: { ProjectileSlot } = {}
local sparkSlots: { SparkSlot } = {}
local ringSlots: { RingSlot } = {}
local placeSlots: { PlaceSlot } = {}
local nextProjectile = 1
local nextSpark = 1
local nextRing = 1
local nextPlace = 1
local activeProjectiles = 0
local projectileConnection: RBXScriptConnection? = nil
local visualCache: { [string]: UnitVisual } = {}

local flashFrame: Frame? = nil
local flashTween: Tween? = nil

local bannerLabel: TextLabel? = nil
local bannerStroke: UIStroke? = nil
local bannerScale: UIScale? = nil
local bannerTweens: { Tween } = {}
local bannerToken = 0

local victoryHolder: Frame? = nil
local victoryPieces: { Frame } = {}
local victoryTokens: { number } = {}

local gradeEffect: ColorCorrectionEffect? = nil
local gradeTween: Tween? = nil

local pingSound: Sound? = nil

-- Tremor de camera (estado simples, sem tabelas).
local shakeTime = 0
local shakeDuration = 0.4
local shakeMagnitude = 0
local shakeBound = false

local function cancelAll(tweens: { Tween })
	for _, tween in tweens do
		tween:Cancel()
	end
	table.clear(tweens)
end

local function randomColor(): Color3
	return PALETTE[math.random(1, #PALETTE)]
end

local function playPing(volume: number, minSpeed: number, maxSpeed: number)
	local sound = pingSound
	if not SOUND_ENABLED or not sound then
		return
	end
	sound.Volume = volume
	sound.PlaybackSpeed = minSpeed + math.random() * (maxSpeed - minSpeed) -- varia o tom para nao cansar
	sound:Play()
end

-- ---------------------------------------------------------------------------
-- Confete 3D (pool de Parts com ParticleEmitters)
-- ---------------------------------------------------------------------------

local function makeBurstSlot(folder: Folder, colors: { Color3 }, speedMax: number, sizeMax: number): BurstSlot
	-- ParticleEmitter precisa de um Part "normal" (invisivel e sem colisao).
	local part = Instance.new("Part")
	part.Name = "BurstSlot"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.Position = Vector3.new(0, -500, 0) -- guardado longe ate ser usado
	part.Parent = folder

	local attachment = Instance.new("Attachment")
	attachment.Parent = part

	local emitters: { ParticleEmitter } = {}
	for i, color in colors do
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false -- so solta particulas quando chamamos :Emit()
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.6, 1.2)
		emitter.Speed = NumberRange.new(speedMax * 0.4, speedMax)
		emitter.SpreadAngle = Vector2.new(360, 360)
		emitter.Acceleration = Vector3.new(0, -60, 0)
		emitter.Drag = 2
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-300, 300)
		emitter.LightEmission = 0.6
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new(sizeMax, 0)
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		-- Gradiente da cor para a proxima cor da paleta: cada pedacinho muda de cor ao cair.
		emitter.Color = ColorSequence.new(color, colors[i % #colors + 1])
		emitter.Parent = attachment
		table.insert(emitters, emitter)
	end

	-- Um brilho rapido de luz (so 1 PointLight por slot, sem sombras: barato).
	local light = Instance.new("PointLight")
	light.Range = 12
	light.Brightness = 0
	light.Shadows = false
	light.Parent = part

	return { part = part, emitters = emitters, light = light, lightTween = nil }
end

local function burst(slots: { BurstSlot }, index: number, position: Vector3, perColor: number, lightColor: Color3)
	local slot = slots[index]
	slot.part.Position = position
	for _, emitter in slot.emitters do
		emitter:Emit(perColor)
	end
	local old = slot.lightTween
	if old then
		old:Cancel()
	end
	slot.light.Color = lightColor
	slot.light.Brightness = 4
	local tween = TweenService:Create(slot.light, LIGHT_FADE, { Brightness = 0 })
	slot.lightTween = tween
	tween:Play()
end

-- ---------------------------------------------------------------------------
-- Numeros flutuantes (pool de BillboardGuis)
-- ---------------------------------------------------------------------------

local function makeNumberSlot(folder: Folder): NumberSlot
	local part = Instance.new("Part")
	part.Name = "NumberSlot"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.Position = Vector3.new(0, -500, 0)
	part.Parent = folder

	local gui = Instance.new("BillboardGui")
	gui.Adornee = part
	gui.Size = UDim2.fromScale(5, 2) -- em studs
	gui.AlwaysOnTop = true
	gui.MaxDistance = 200
	gui.Active = false
	gui.Enabled = false
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = ""
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = gui

	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 12
	limit.MaxTextSize = 60
	limit.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Color = DARK
	stroke.Thickness = 3
	stroke.Parent = label

	local scale = Instance.new("UIScale")
	scale.Parent = label

	return { part = part, gui = gui, label = label, scale = scale, stroke = stroke, token = 0, tweens = {} }
end

local function showNumber(position: Vector3, text: string)
	local slot = numberSlots[nextNumber]
	nextNumber = nextNumber % #numberSlots + 1 -- se todos estao em uso, reaproveita o mais antigo

	slot.token += 1
	local myToken = slot.token
	cancelAll(slot.tweens)

	slot.part.Position = position + Vector3.new((math.random() - 0.5) * 3, 1, (math.random() - 0.5) * 3)
	slot.gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
	slot.label.Text = text
	slot.label.TextColor3 = randomColor()
	slot.label.TextTransparency = 0
	slot.stroke.Transparency = 0
	slot.scale.Scale = 0.2
	slot.gui.Enabled = true

	local pop = TweenService:Create(slot.scale, NUMBER_POP, { Scale = 1.2 })
	local rise = TweenService:Create(slot.gui, NUMBER_RISE, { StudsOffsetWorldSpace = Vector3.new(0, 6, 0) })
	local fadeText = TweenService:Create(slot.label, NUMBER_FADE, { TextTransparency = 1 })
	local fadeStroke = TweenService:Create(slot.stroke, NUMBER_FADE, { Transparency = 1 })
	table.insert(slot.tweens, pop)
	table.insert(slot.tweens, rise)
	table.insert(slot.tweens, fadeText)
	table.insert(slot.tweens, fadeStroke)

	fadeText.Completed:Once(function()
		if slot.token == myToken then
			slot.gui.Enabled = false
		end
	end)
	pop:Play()
	rise:Play()
	fadeText:Play()
	fadeStroke:Play()
end

-- ---------------------------------------------------------------------------
-- Visual das unidades (lido do Config, com valores reserva)
-- ---------------------------------------------------------------------------

local function styleFromName(name: unknown, kind: string): number
	if name == "Shuriken" then
		return STYLE_SHURIKEN
	elseif name == "Slash" then
		return STYLE_SLASH
	elseif name == "Orb" then
		return STYLE_ORB
	end
	-- Sem Config: adivinha pelo nome do tipo para o efeito ainda fazer sentido.
	if kind == "Ninja" then
		return STYLE_SHURIKEN
	elseif kind == "Samurai" then
		return STYLE_SLASH
	end
	return STYLE_ORB
end

-- Guardamos o resultado numa tabela (cache) para nao recalcular a cada ataque.
local function getVisual(kind: string): UnitVisual
	local cached = visualCache[kind]
	if cached then
		return cached
	end
	local entry: any = nil
	local units: any = Config.UNITS
	if typeof(units) == "table" then
		entry = units[kind]
	end
	local visual: UnitVisual
	if typeof(entry) == "table" then
		visual = {
			style = styleFromName(entry.attackStyle, kind),
			color = if typeof(entry.color) == "Color3" then entry.color else PALETTE[5],
			accent = if typeof(entry.accentColor) == "Color3" then entry.accentColor else PALETTE[2],
			splash = if typeof(entry.splashRadius) == "number" then entry.splashRadius else 0,
			height = if typeof(entry.height) == "number" then entry.height else 4,
		}
	else
		visual = {
			style = styleFromName(nil, kind),
			color = PALETTE[5],
			accent = PALETTE[2],
			splash = 0,
			height = 4,
		}
	end
	visualCache[kind] = visual
	return visual
end

-- ---------------------------------------------------------------------------
-- Faiscas de impacto (pool: 1 emissor + 1 luz por slot)
-- ---------------------------------------------------------------------------

local function makeSparkSlot(folder: Folder): SparkSlot
	local part = Instance.new("Part")
	part.Name = "SparkSlot"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.Position = HIDDEN_POSITION
	part.Parent = folder

	local attachment = Instance.new("Attachment")
	attachment.Parent = part

	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.2, 0.45)
	emitter.Speed = NumberRange.new(14, 34)
	emitter.SpreadAngle = Vector2.new(360, 360)
	emitter.Drag = 4
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new(0.55, 0)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.6, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = attachment

	local light = Instance.new("PointLight")
	light.Range = 10
	light.Brightness = 0
	light.Shadows = false
	light.Parent = part

	return { part = part, emitter = emitter, light = light, lightTween = nil }
end

local function spark(position: Vector3, color: Color3, count: number)
	local slot = sparkSlots[nextSpark]
	nextSpark = nextSpark % #sparkSlots + 1
	slot.part.Position = position
	-- Particulas nascem com a cor do momento: assim cada unidade solta faiscas da sua cor.
	slot.emitter.Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(color, 0.5), color)
	slot.emitter:Emit(count)
	local old = slot.lightTween
	if old then
		old:Cancel()
	end
	slot.light.Color = color
	slot.light.Brightness = 3
	local tween = TweenService:Create(slot.light, LIGHT_FADE, { Brightness = 0 })
	slot.lightTween = tween
	tween:Play()
end

-- ---------------------------------------------------------------------------
-- Aneis de explosao (pool de cilindros finos, deitados no chao)
-- ---------------------------------------------------------------------------

local RING_INFO = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function makeRingSlot(folder: Folder): RingSlot
	local part = Instance.new("Part")
	part.Name = "RingSlot"
	part.Shape = Enum.PartType.Cylinder
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.3, 1, 1)
	part.Position = HIDDEN_POSITION
	part.Parent = folder
	return { part = part, tweens = {} }
end

-- O cilindro do Roblox tem o eixo no X; girar 90 graus em Z deixa ele "deitado" (fino na vertical).
local FLAT = CFrame.Angles(0, 0, math.rad(90))

local function playRing(slot: RingSlot, position: Vector3, color: Color3, diameter: number, info: TweenInfo)
	cancelAll(slot.tweens)
	local part = slot.part
	part.Color = color
	part.Size = Vector3.new(0.35, 1, 1)
	part.Transparency = 0.15
	part.CFrame = CFrame.new(position) * FLAT
	local grow = TweenService:Create(part, info, { Size = Vector3.new(0.35, diameter, diameter), Transparency = 1 })
	table.insert(slot.tweens, grow)
	grow:Play()
end

local function ring(position: Vector3, color: Color3, diameter: number)
	local slot = ringSlots[nextRing]
	nextRing = nextRing % #ringSlots + 1
	playRing(slot, position, color, diameter, RING_INFO)
end

-- ---------------------------------------------------------------------------
-- Projeteis das unidades (pool de 2 pecas por slot + UM loop so enquanto houver ataque)
-- ---------------------------------------------------------------------------

local function makeEffectPart(folder: Folder, name: string): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.5
	part.Position = HIDDEN_POSITION
	part.Parent = folder
	return part
end

local function makeProjectileSlot(folder: Folder): ProjectileSlot
	return {
		part = makeEffectPart(folder, "ProjectileSlot"),
		aux = makeEffectPart(folder, "ProjectileAux"),
		active = false,
		style = STYLE_SHURIKEN,
		t = 0,
		duration = 0.2,
		from = Vector3.zero,
		to = Vector3.zero,
		base = CFrame.new(),
		arc = 0,
		visual = getVisual("Ninja"),
	}
end

local function finishProjectile(slot: ProjectileSlot)
	slot.active = false
	slot.part.Transparency = 1
	slot.aux.Transparency = 1
	activeProjectiles -= 1
	local accent = slot.visual.accent
	if slot.style == STYLE_ORB then
		-- Orb: anel no tamanho da area de dano + um pouco de confete.
		local diameter = if slot.visual.splash > 0 then slot.visual.splash * 2 else 5
		ring(slot.to, accent, diameter)
		spark(slot.to, accent, 14)
		burst(burstSlots, nextBurst, slot.to, 2, accent)
		nextBurst = nextBurst % #burstSlots + 1
	elseif slot.style == STYLE_SLASH then
		spark(slot.to, Color3.new(1, 1, 1), 12)
	else
		spark(slot.to, accent, 8)
	end
end

local function onProjectileStep(dt: number)
	for _, slot in projectileSlots do
		if not slot.active then
			continue
		end
		slot.t += dt
		local a = slot.t / slot.duration
		if a >= 1 then
			finishProjectile(slot)
			continue
		end
		local style = slot.style
		if style == STYLE_SHURIKEN then
			local cf = CFrame.new(slot.from:Lerp(slot.to, a)) * CFrame.Angles(0, slot.t * 45, 0)
			slot.part.CFrame = cf
			slot.aux.CFrame = cf * CFrame.Angles(0, math.rad(90), 0)
		elseif style == STYLE_SLASH then
			-- Gira em volta do eixo de frente: parece um talho cruzando o inimigo.
			local eased = 1 - (1 - a) * (1 - a)
			local angle = -1.2 + 2.4 * eased
			local cf = slot.base * CFrame.Angles(0, 0, angle)
			slot.part.CFrame = cf
			slot.aux.CFrame = cf
			local fade = 0.1 + 0.9 * a * a
			slot.part.Transparency = fade
			slot.aux.Transparency = fade
		else
			local pos = slot.from:Lerp(slot.to, a) + Vector3.new(0, slot.arc * 4 * a * (1 - a), 0)
			local cf = CFrame.new(pos)
			slot.part.CFrame = cf
			slot.aux.CFrame = cf
		end
	end
	if activeProjectiles <= 0 then
		-- Nada voando: desliga o loop (nao gasta nada parado).
		local connection = projectileConnection
		if connection then
			connection:Disconnect()
			projectileConnection = nil
		end
	end
end

local function launchProjectile(visual: UnitVisual, from: Vector3, to: Vector3): boolean
	local count = #projectileSlots
	local slot: ProjectileSlot? = nil
	for i = 0, count - 1 do
		local index = (nextProjectile + i - 1) % count + 1
		local candidate = projectileSlots[index]
		if not candidate.active then
			slot = candidate
			nextProjectile = index % count + 1
			break
		end
	end
	if not slot then
		return false -- limite atingido: melhor perder um efeito do que travar o celular
	end

	local delta = to - from
	local distance = delta.Magnitude
	local part = slot.part
	local aux = slot.aux
	local accent = visual.accent

	slot.visual = visual
	slot.style = visual.style
	slot.t = 0
	slot.from = from
	slot.to = to
	part.Color = accent

	if visual.style == STYLE_SHURIKEN then
		slot.duration = math.clamp(distance / 90, 0.12, 0.2)
		part.Shape = Enum.PartType.Block
		aux.Shape = Enum.PartType.Block
		part.Size = Vector3.new(1.3, 0.1, 0.3)
		aux.Size = Vector3.new(1.3, 0.1, 0.3)
		aux.Color = Color3.new(1, 1, 1)
		part.Transparency = 0
		aux.Transparency = 0
		part.CFrame = CFrame.new(from)
		aux.CFrame = CFrame.new(from)
	elseif visual.style == STYLE_SLASH then
		slot.duration = 0.2
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude < 0.01 then
			flat = Vector3.zAxis
		end
		slot.base = CFrame.lookAt(to, to + flat.Unit)
		part.Shape = Enum.PartType.Block
		aux.Shape = Enum.PartType.Block
		part.Size = Vector3.new(5, 0.16, 0.6)
		aux.Size = Vector3.new(5.4, 0.07, 0.22)
		aux.Color = Color3.new(1, 1, 1)
		part.Transparency = 0.1
		aux.Transparency = 0.1
		part.CFrame = slot.base
		aux.CFrame = slot.base
		spark(to, Color3.new(1, 1, 1), 4) -- clarao branco logo no inicio do talho
	else
		slot.duration = math.clamp(distance / 45, 0.25, 0.45)
		slot.arc = 3 + distance * 0.15
		part.Shape = Enum.PartType.Ball
		aux.Shape = Enum.PartType.Ball
		part.Size = Vector3.one * 1.4
		aux.Size = Vector3.one * 2.6
		aux.Color = accent
		part.Transparency = 0
		aux.Transparency = 0.65
		part.CFrame = CFrame.new(from)
		aux.CFrame = CFrame.new(from)
	end

	slot.active = true
	activeProjectiles += 1
	if not projectileConnection then
		projectileConnection = RunService.Heartbeat:Connect(onProjectileStep)
	end
	return true
end

-- ---------------------------------------------------------------------------
-- Explosao de luz ao colocar uma unidade (pool de esfera + pilar + anel + luz)
-- ---------------------------------------------------------------------------

local SPHERE_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PILLAR_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PLACE_RING_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function makePlaceSlot(folder: Folder): PlaceSlot
	local sphere = makeEffectPart(folder, "PlaceSphere")
	sphere.Shape = Enum.PartType.Ball

	local pillar = makeEffectPart(folder, "PlacePillar")
	pillar.Shape = Enum.PartType.Cylinder

	local light = Instance.new("PointLight")
	light.Range = 26
	light.Brightness = 0
	light.Shadows = false
	light.Parent = sphere

	return { sphere = sphere, pillar = pillar, ring = makeRingSlot(folder), light = light, tweens = {} }
end

local function placeExplosion(position: Vector3, visual: UnitVisual)
	local slot = placeSlots[nextPlace]
	nextPlace = nextPlace % #placeSlots + 1
	cancelAll(slot.tweens)

	local accent = visual.accent

	-- Esfera de luz que cresce e some.
	slot.sphere.Color = accent
	slot.sphere.Size = Vector3.one * 1.5
	slot.sphere.Transparency = 0.2
	slot.sphere.Position = position
	local grow = TweenService:Create(slot.sphere, SPHERE_INFO, { Size = Vector3.one * 11, Transparency = 1 })

	-- Pilar de luz vertical (cilindro em pe: Size.X e a altura).
	local pillarHeight = 18
	slot.pillar.Color = Color3.new(1, 1, 1):Lerp(accent, 0.4)
	slot.pillar.Size = Vector3.new(pillarHeight, 4, 4)
	slot.pillar.Transparency = 0.2
	slot.pillar.CFrame = CFrame.new(position + Vector3.new(0, pillarHeight * 0.5 - 1.5, 0)) * FLAT
	local rise = TweenService:Create(slot.pillar, PILLAR_INFO, { Size = Vector3.new(pillarHeight * 1.4, 0.4, 0.4), Transparency = 1 })

	-- Flash de luz.
	slot.light.Color = accent
	slot.light.Brightness = 8
	local flash = TweenService:Create(slot.light, LIGHT_FADE, { Brightness = 0 })

	table.insert(slot.tweens, grow)
	table.insert(slot.tweens, rise)
	table.insert(slot.tweens, flash)
	grow:Play()
	rise:Play()
	flash:Play()

	-- Anel no chao (usa o proprio anel do slot, reservado para esta explosao).
	cancelAll(slot.ring.tweens)
	playRing(slot.ring, position - Vector3.new(0, visual.height * 0.35, 0), accent, 14, PLACE_RING_INFO)
end

-- ---------------------------------------------------------------------------
-- Tremor de camera
-- ---------------------------------------------------------------------------

local function stopShake()
	if shakeBound then
		shakeBound = false
		RunService:UnbindFromRenderStep(SHAKE_BIND_NAME)
	end
end

local function onShakeStep(dt: number)
	shakeTime += dt
	local alpha = 1 - shakeTime / shakeDuration
	if alpha <= 0 then
		-- Acabou: desliga o passo de render para nunca brigar com a camera.
		stopShake()
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local magnitude = shakeMagnitude * alpha * alpha -- vai diminuindo rapido
	local offsetX = (math.random() - 0.5) * 2 * magnitude
	local offsetY = (math.random() - 0.5) * 2 * magnitude
	local roll = (math.random() - 0.5) * 0.04 * alpha
	-- Deslocamento em cima da camera padrao, que se recalcula todo frame (nao acumula).
	camera.CFrame = camera.CFrame * CFrame.new(offsetX, offsetY, 0) * CFrame.Angles(0, 0, roll)
end

local function startShake(magnitude: number, duration: number)
	shakeTime = 0
	shakeDuration = duration
	shakeMagnitude = magnitude
	if not shakeBound then
		shakeBound = true
		-- Prioridade logo DEPOIS da camera: ela calcula primeiro, nos deslocamos depois.
		RunService:BindToRenderStep(SHAKE_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, onShakeStep)
	end
end

-- ---------------------------------------------------------------------------
-- Flash vermelho, banner e confete de UI
-- ---------------------------------------------------------------------------

local function redFlash()
	local frame = flashFrame
	if not frame then
		return
	end
	local old = flashTween
	if old then
		old:Cancel()
	end
	frame.BackgroundTransparency = 0.55
	local tween = TweenService:Create(frame, FLASH_FADE, { BackgroundTransparency = 1 })
	flashTween = tween
	tween:Play()
end

local function showBanner(text: string, fill: Color3, outline: Color3, hold: number)
	local label = bannerLabel
	local stroke = bannerStroke
	local scale = bannerScale
	if not label or not stroke or not scale then
		return
	end

	bannerToken += 1
	local myToken = bannerToken
	cancelAll(bannerTweens)

	label.Text = text
	label.TextColor3 = fill
	label.TextTransparency = 0
	stroke.Color = outline
	stroke.Transparency = 0
	scale.Scale = 0
	label.Visible = true

	-- Entra com "pop" (Back passa um pouco do tamanho e volta).
	local pop = TweenService:Create(scale, POP_IN, { Scale = 1 })
	table.insert(bannerTweens, pop)
	pop:Play()

	-- Depois de um tempo, some. Se outro banner chegar antes, o token mudou e nada acontece.
	task.delay(hold, function()
		if bannerToken ~= myToken then
			return
		end
		local fadeText = TweenService:Create(label, BANNER_FADE, { TextTransparency = 1 })
		local fadeStroke = TweenService:Create(stroke, BANNER_FADE, { Transparency = 1 })
		table.insert(bannerTweens, fadeText)
		table.insert(bannerTweens, fadeStroke)
		fadeText.Completed:Once(function()
			if bannerToken == myToken then
				label.Visible = false
			end
		end)
		fadeText:Play()
		fadeStroke:Play()
	end)
end

local function launchVictoryConfetti()
	local holder = victoryHolder
	if not holder then
		return
	end
	-- Cria os pedacinhos so na primeira vitoria; depois reaproveita os mesmos.
	if #victoryPieces == 0 then
		for i = 1, VICTORY_PIECES do
			local piece = Instance.new("Frame")
			piece.Name = "Piece"
			piece.Size = UDim2.fromScale(0.012, 0.022)
			piece.BorderSizePixel = 0
			piece.Visible = false
			piece.Parent = holder
			victoryPieces[i] = piece
			victoryTokens[i] = 0
		end
	end

	for i, piece in victoryPieces do
		victoryTokens[i] += 1
		local myToken = victoryTokens[i]
		local startX = math.random()
		local startRotation = math.random(0, 360)
		piece.BackgroundColor3 = randomColor()
		piece.Position = UDim2.fromScale(startX, -0.08)
		piece.Rotation = startRotation
		piece.Visible = true

		-- DelayTime escalona a queda sem precisar de task.delay.
		local info = TweenInfo.new(2.2 + math.random() * 1.8, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, math.random() * 0.9)
		local tween = TweenService:Create(piece, info, {
			Position = UDim2.fromScale(startX + (math.random() - 0.5) * 0.3, 1.08),
			Rotation = startRotation + math.random(-720, 720),
		})
		tween.Completed:Once(function()
			if victoryTokens[i] == myToken then
				piece.Visible = false
			end
		end)
		tween:Play()
	end
end

-- Cor da tela (ColorCorrection local): cinza na derrota, normal nas outras fases.
local function setGrade(saturation: number, brightness: number)
	local effect = gradeEffect
	if not effect then
		return
	end
	local old = gradeTween
	if old then
		old:Cancel()
	end
	local tween = TweenService:Create(effect, GRADE_INFO, { Saturation = saturation, Brightness = brightness })
	gradeTween = tween
	tween:Play()
end

-- ---------------------------------------------------------------------------
-- Eventos do servidor
-- ---------------------------------------------------------------------------

local function onEnemyDied(id: string, reason: string, position: Vector3, reward: number)
	if typeof(position) ~= "Vector3" then
		return
	end
	if reason == "Killed" then
		burst(burstSlots, nextBurst, position, CONFETTI_PER_COLOR, PALETTE[math.random(1, #PALETTE)])
		nextBurst = nextBurst % #burstSlots + 1
		showNumber(position, "+" .. tostring(reward))
		playPing(0.25, 1.2, 1.8)
	else
		-- Vazou: explosao vermelha pequena.
		burst(leakSlots, nextLeak, position, 5, RED)
		nextLeak = nextLeak % #leakSlots + 1
		playPing(0.2, 0.6, 0.8)
	end
end

local function onBaseHit(damage: number, _healthLeft: number)
	-- Quanto maior o dano, mais forte o tremor (com limites).
	local magnitude = math.clamp(0.4 + damage * 0.05, 0.4, 2)
	startShake(magnitude, 0.45)
	redFlash()
	playPing(0.3, 0.4, 0.55)
end

local function onWaveStarted(wave: number, _waveCount: number, isBoss: boolean)
	if isBoss then
		showBanner("BOSS WAVE!", RED, GOLD, 2)
	else
		showBanner("WAVE " .. tostring(wave), Color3.new(1, 1, 1), PALETTE[1], 1.4)
	end
	playPing(0.25, 0.9, 1.1)
end

local function onMatchEnded(result: string)
	if result == "Victory" then
		showBanner("VICTORY!", GOLD, PALETTE[1], 3.5)
		launchVictoryConfetti()
		playPing(0.3, 1.4, 1.6)
	else
		showBanner("DEFEAT", Color3.fromRGB(190, 190, 200), DARK, 3.5)
		setGrade(-0.85, -0.05)
	end
end

local function onUnitPlaced(_id: string, kind: string, position: Vector3, ownerUserId: number)
	if typeof(position) ~= "Vector3" or typeof(kind) ~= "string" then
		return
	end
	local visual = getVisual(kind)
	placeExplosion(position, visual)
	-- Confete da paleta toda (reaproveita o pool de confete que ja existe).
	burst(burstSlots, nextBurst, position + Vector3.new(0, 2, 0), CONFETTI_PER_COLOR, visual.accent)
	nextBurst = nextBurst % #burstSlots + 1
	showNumber(position + Vector3.new(0, visual.height, 0), "NEW!")
	playPing(0.3, 1.0, 1.3)
	-- Tremor so para quem colocou a unidade, bem leve.
	if ownerUserId == Players.LocalPlayer.UserId then
		startShake(0.25, 0.25)
	end
end

local function onUnitAttacked(_id: string, kind: string, from: Vector3, to: Vector3)
	if typeof(kind) ~= "string" or typeof(from) ~= "Vector3" or typeof(to) ~= "Vector3" then
		return
	end
	launchProjectile(getVisual(kind), from, to)
end

local function makeLabelBase(parent: Instance): (TextLabel, UIStroke, UIScale)
	local label = Instance.new("TextLabel")
	label.Name = "Banner"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.35)
	label.Size = UDim2.fromScale(0.6, 0.16)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = ""
	label.ZIndex = 10 -- acima do confete e do flash
	label.Visible = false
	label.Parent = parent

	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = 14
	limit.MaxTextSize = 110
	limit.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 5
	stroke.Parent = label

	local scale = Instance.new("UIScale")
	scale.Parent = label

	return label, stroke, scale
end

function FxController.init() end

function FxController.start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- Pasta local no workspace para as pecas dos efeitos (so este jogador ve).
	local folder = Instance.new("Folder")
	folder.Name = "ClientFx"
	folder.Parent = workspace
	fxFolder = folder

	for _ = 1, BURST_POOL_SIZE do
		table.insert(burstSlots, makeBurstSlot(folder, PALETTE, 45, 0.7))
	end
	local leakColors: { Color3 } = { RED, Color3.fromRGB(255, 140, 40) }
	for _ = 1, LEAK_POOL_SIZE do
		table.insert(leakSlots, makeBurstSlot(folder, leakColors, 25, 0.5))
	end
	for _ = 1, NUMBER_POOL_SIZE do
		table.insert(numberSlots, makeNumberSlot(folder))
	end

	for _ = 1, PROJECTILE_POOL_SIZE do
		table.insert(projectileSlots, makeProjectileSlot(folder))
	end
	for _ = 1, SPARK_POOL_SIZE do
		table.insert(sparkSlots, makeSparkSlot(folder))
	end
	for _ = 1, RING_POOL_SIZE do
		table.insert(ringSlots, makeRingSlot(folder))
	end
	for _ = 1, PLACE_POOL_SIZE do
		table.insert(placeSlots, makePlaceSlot(folder))
	end

	-- Interface dos efeitos: tela cheia (IgnoreGuiInset) para o flash cobrir tudo.
	local gui = Instance.new("ScreenGui")
	gui.Name = "Fx"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	local flash = Instance.new("Frame")
	flash.Name = "RedFlash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = RED
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Active = false
	flash.ZIndex = 1
	flash.Parent = gui
	flashFrame = flash

	local holder = Instance.new("Frame")
	holder.Name = "VictoryConfetti"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Active = false
	holder.ZIndex = 5
	holder.Parent = gui
	victoryHolder = holder

	bannerLabel, bannerStroke, bannerScale = makeLabelBase(gui)

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "TokyoBurstGrade"
	grade.Parent = Lighting
	gradeEffect = grade

	if SOUND_ENABLED then
		local sound = Instance.new("Sound")
		sound.Name = "FxPing"
		sound.SoundId = SOUND_ID
		sound.Volume = 0.25
		sound.Parent = SoundService
		pingSound = sound
	end

	-- Remotes: Net.event espera o servidor criar (tempo limite dentro do Net).
	table.insert(connections, Net.event("EnemyDied").OnClientEvent:Connect(onEnemyDied))
	table.insert(connections, Net.event("BaseHit").OnClientEvent:Connect(onBaseHit))
	table.insert(connections, Net.event("WaveStarted").OnClientEvent:Connect(onWaveStarted))
	table.insert(connections, Net.event("MatchEnded").OnClientEvent:Connect(onMatchEnded))
	table.insert(connections, Net.event("UnitPlaced").OnClientEvent:Connect(onUnitPlaced))
	table.insert(connections, Net.event("UnitAttacked").OnClientEvent:Connect(onUnitAttacked))

	-- Sai do modo cinza assim que a partida deixa o estado Defeat (ex.: reiniciou).
	local matchState = ReplicatedStorage:WaitForChild("MatchState", 30)
	if matchState then
		table.insert(
			connections,
			matchState:GetAttributeChangedSignal("State"):Connect(function()
				if matchState:GetAttribute("State") ~= "Defeat" then
					setGrade(0, 0)
				end
			end)
		)
	end
end

-- Limpeza explicita (nao usada no jogo normal): desliga tudo e solta a camera.
function FxController.destroy()
	stopShake()
	local projectileLoop = projectileConnection
	if projectileLoop then
		projectileLoop:Disconnect()
		projectileConnection = nil
	end
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	if fxFolder then
		fxFolder:Destroy()
	end
	if gradeEffect then
		gradeEffect:Destroy()
	end
end

return FxController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001B">
						<Properties>
							<string name="Name">HudController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- HudController: o HUD (interface) do jogo: titulo, onda, estado/contagem e vida da base.
-- Tudo em Scale (porcentagem da tela) para funcionar em celular e PC.
-- O HUD so MOSTRA o que o servidor diz (atributos da pasta MatchState). Ele nunca decide nada.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local PINK = Color3.fromRGB(255, 51, 153)
local CYAN = Color3.fromRGB(0, 240, 255)
local YELLOW = Color3.fromRGB(255, 225, 60)
local LIME = Color3.fromRGB(120, 255, 90)
local RED = Color3.fromRGB(255, 50, 70)
local DARK = Color3.fromRGB(20, 12, 40)

-- Animacoes reaproveitadas (criar TweenInfo uma vez so).
local POP_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local FILL_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- A contagem regressiva so precisa atualizar 10 vezes por segundo.
local COUNTDOWN_INTERVAL = 0.1
-- Abaixo dessa fracao de vida a barra fica vermelha.
local LOW_HEALTH_RATIO = 0.3

local HudController = {}

local connections: { RBXScriptConnection } = {}
local popTweens: { [UIScale]: Tween } = {}

-- Contador de dinheiro: o numero "sobe" aos poucos (count-up) em vez de pular.
local CASH_UP_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local CASH_DOWN_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local CASH_FLASH_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local cashTween: Tween? = nil
local cashFlashTween: Tween? = nil

-- Le um atributo numero com valor padrao (atributo pode ainda nao existir).
local function getNumber(inst: Instance, name: string, default: number): number
	local value = inst:GetAttribute(name)
	if typeof(value) == "number" then
		return value
	end
	return default
end

-- "Pop": o elemento comeca maior e volta ao normal com easing Back (efeito elastico).
local function popScale(uiScale: UIScale, from: number)
	local old = popTweens[uiScale]
	if old then
		old:Cancel() -- evita dois tweens brigando pela mesma propriedade
	end
	uiScale.Scale = from
	local tween = TweenService:Create(uiScale, POP_INFO, { Scale = 1 })
	popTweens[uiScale] = tween
	tween:Play()
end

-- Cria um texto padrao do HUD: escala com a tela, com limites e contorno para ler bem.
local function makeLabel(
	parent: Instance,
	name: string,
	position: UDim2,
	size: UDim2,
	text: string,
	color: Color3,
	minSize: number,
	maxSize: number
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = position
	label.Size = size
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true -- o texto se ajusta ao tamanho da caixa
	label.TextColor3 = color
	label.Parent = parent

	-- Limites: o texto nao fica minusculo no celular nem gigante no PC.
	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize = minSize
	limit.MaxTextSize = maxSize
	limit.Parent = label

	local stroke = Instance.new("UIStroke")
	stroke.Color = DARK
	stroke.Thickness = 2
	stroke.Parent = label

	return label
end

function HudController.init() end

function HudController.start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	local gui = Instance.new("ScreenGui")
	gui.Name = "Hud"
	gui.ResetOnSpawn = false -- nao some quando o personagem morre
	gui.IgnoreGuiInset = false -- respeita a barra superior do Roblox
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets -- foge do notch/barra do celular
	gui.Parent = playerGui

	-- Titulo pequeno no canto superior esquerdo (o centro fica para a onda e a vida).
	local title = makeLabel(
		gui,
		"Title",
		UDim2.fromScale(0.01, 0.01),
		UDim2.fromScale(0.2, 0.04),
		"TOKYO BURST TD",
		CYAN,
		12,
		26
	)
	title.AnchorPoint = Vector2.new(0, 0)
	local titleStroke = title:FindFirstChildOfClass("UIStroke")
	if titleStroke then
		titleStroke.Color = PINK
		-- Pulso: um Tween so, repetindo para sempre. Bem mais leve do que mexer a cada frame.
		local pulseInfo = TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		TweenService:Create(titleStroke, pulseInfo, { Thickness = 3, Color = CYAN }):Play()
		TweenService:Create(title, pulseInfo, { TextColor3 = PINK }):Play()
	end

	local tag = makeLabel(
		gui,
		"BuildTag",
		UDim2.fromScale(0.01, 0.05),
		UDim2.fromScale(0.12, 0.03),
		"Week 3 build",
		Color3.fromRGB(200, 215, 255),
		12,
		16
	)
	tag.AnchorPoint = Vector2.new(0, 0)
	tag.Font = Enum.Font.GothamBold
	tag.TextTransparency = 0.2

	-- Contador de dinheiro, topo direito. Le o atributo "Cash" do jogador (so o servidor escreve).
	local localPlayer = Players.LocalPlayer
	local cashLabel = makeLabel(
		gui,
		"CashLabel",
		UDim2.fromScale(0.99, 0.01),
		UDim2.fromScale(0.2, 0.06),
		"$0",
		YELLOW,
		14,
		40
	)
	cashLabel.AnchorPoint = Vector2.new(1, 0)
	cashLabel.TextXAlignment = Enum.TextXAlignment.Right
	local cashScale = Instance.new("UIScale")
	cashScale.Parent = cashLabel

	-- NumberValue so serve para o tween "contar": o texto segue o Value dele.
	local shownValue = Instance.new("NumberValue")
	shownValue.Name = "CashShown"
	shownValue.Parent = cashLabel
	local lastShown = -1
	table.insert(
		connections,
		shownValue.Changed:Connect(function(value: number)
			local rounded = math.floor(value + 0.5)
			if rounded == lastShown then
				return -- sem texto novo a toa
			end
			lastShown = rounded
			cashLabel.Text = "$" .. rounded
		end)
	)

	local lastCash = getNumber(localPlayer, "Cash", 0)
	shownValue.Value = lastCash

	local function updateCash()
		local cash = getNumber(localPlayer, "Cash", 0)
		if cash == lastCash then
			return
		end
		local gained = cash > lastCash
		lastCash = cash

		local oldCount = cashTween
		if oldCount then
			oldCount:Cancel()
		end
		local count = TweenService:Create(shownValue, if gained then CASH_UP_INFO else CASH_DOWN_INFO, { Value = cash })
		cashTween = count
		count:Play()

		local oldFlash = cashFlashTween
		if oldFlash then
			oldFlash:Cancel()
		end
		if gained then
			popScale(cashScale, 1.35) -- ganhou: pop grande
			cashLabel.TextColor3 = Color3.new(1, 1, 1)
		else
			popScale(cashScale, 0.8) -- gastou: encolhe e volta
			cashLabel.TextColor3 = RED -- flash vermelho
		end
		local flash = TweenService:Create(cashLabel, CASH_FLASH_INFO, { TextColor3 = YELLOW })
		cashFlashTween = flash
		flash:Play()
	end
	table.insert(connections, localPlayer:GetAttributeChangedSignal("Cash"):Connect(updateCash))

	-- Etiqueta da onda, topo centro.
	local waveLabel = makeLabel(
		gui,
		"WaveLabel",
		UDim2.fromScale(0.5, 0.01),
		UDim2.fromScale(0.3, 0.06),
		"WAVE 0/10",
		YELLOW,
		14,
		44
	)
	local waveScale = Instance.new("UIScale")
	waveScale.Parent = waveLabel

	-- Etiqueta de estado/contagem, logo abaixo da onda.
	local stateLabel = makeLabel(
		gui,
		"StateLabel",
		UDim2.fromScale(0.5, 0.07),
		UDim2.fromScale(0.3, 0.045),
		"",
		CYAN,
		12,
		30
	)

	-- Barra de vida da base.
	local barFrame = Instance.new("Frame")
	barFrame.Name = "BaseHealthBar"
	barFrame.AnchorPoint = Vector2.new(0.5, 0)
	barFrame.Position = UDim2.fromScale(0.5, 0.12)
	barFrame.Size = UDim2.fromScale(0.36, 0.055)
	barFrame.BackgroundColor3 = DARK
	barFrame.BorderSizePixel = 0
	barFrame.Parent = gui

	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(0.5, 0)
	barCorner.Parent = barFrame

	local barStroke = Instance.new("UIStroke")
	barStroke.Color = CYAN
	barStroke.Thickness = 2
	barStroke.Parent = barFrame

	local barScale = Instance.new("UIScale")
	barScale.Parent = barFrame

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = LIME
	fill.BorderSizePixel = 0
	fill.Parent = barFrame

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	local healthText = Instance.new("TextLabel")
	healthText.Name = "HealthText"
	healthText.AnchorPoint = Vector2.new(0.5, 0.5)
	healthText.Position = UDim2.fromScale(0.5, 0.5)
	healthText.Size = UDim2.fromScale(0.6, 0.8)
	healthText.BackgroundTransparency = 1
	healthText.Font = Enum.Font.GothamBlack
	healthText.TextScaled = true
	healthText.TextColor3 = Color3.new(1, 1, 1)
	healthText.Text = ""
	healthText.ZIndex = 2 -- fica por cima da barra colorida
	healthText.Parent = barFrame

	local healthLimit = Instance.new("UITextSizeConstraint")
	healthLimit.MinTextSize = 12
	healthLimit.MaxTextSize = 26
	healthLimit.Parent = healthText

	local healthStroke = Instance.new("UIStroke")
	healthStroke.Color = DARK
	healthStroke.Thickness = 2
	healthStroke.Parent = healthText

	-- A pasta MatchState e criada pelo servidor; esperamos com tempo limite.
	local matchStateInst = ReplicatedStorage:WaitForChild("MatchState", 30)
	if not matchStateInst then
		warn("[HudController] MatchState nao apareceu em 30s; HUD fica parado.")
		return
	end
	local matchState: Instance = matchStateInst

	-- Valores antigos guardados para so mexer na interface quando algo MUDA
	-- (evita criar texto e tween a toa).
	local lastWave = -1
	local lastWaveCount = -1
	local lastHealth = -1
	local lastMaxHealth = -1
	local lastState = ""
	local lastSeconds = -1
	local lastAlive = -1
	local lastStateWave = -1
	local fillTween: Tween? = nil

	local function updateWave()
		local wave = getNumber(matchState, "Wave", 0)
		local waveCount = getNumber(matchState, "WaveCount", 10)
		if wave == lastWave and waveCount == lastWaveCount then
			return
		end
		if wave ~= lastWave and wave > 0 then
			popScale(waveScale, 1.5) -- pop quando entra uma onda nova
		end
		lastWave = wave
		lastWaveCount = waveCount
		waveLabel.Text = "WAVE " .. wave .. "/" .. waveCount
	end

	local function updateState()
		local stateValue = matchState:GetAttribute("State")
		local state = if typeof(stateValue) == "string" then stateValue else "Waiting"
		local endsAt = getNumber(matchState, "StateEndsAt", 0)
		local seconds = 0
		if endsAt > 0 then
			seconds = math.max(0, math.ceil(endsAt - workspace:GetServerTimeNow()))
		end
		local alive = getNumber(matchState, "EnemiesAlive", 0)
		local wave = getNumber(matchState, "Wave", 0)
		local waveCount = getNumber(matchState, "WaveCount", 10)

		if state == lastState and seconds == lastSeconds and alive == lastAlive and wave == lastStateWave then
			return
		end
		lastState = state
		lastSeconds = seconds
		lastAlive = alive
		lastStateWave = wave

		local text = ""
		local color = CYAN
		if state == "Waiting" then
			text = "Waiting for players..."
		elseif state == "Intermission" then
			text = "Next wave in " .. seconds
			color = CYAN
		elseif state == "Wave" then
			if wave >= waveCount and waveCount > 0 then
				text = "BOSS WAVE"
				color = RED
			else
				text = "Enemies: " .. alive
				color = YELLOW
			end
		elseif state == "Victory" then
			text = "VICTORY!"
			color = LIME
			if seconds > 0 then
				text ..= "  Restart in " .. seconds
			end
		elseif state == "Defeat" then
			text = "DEFEAT"
			color = RED
			if seconds > 0 then
				text ..= "  Restart in " .. seconds
			end
		end
		stateLabel.Text = text
		stateLabel.TextColor3 = color
	end

	local function updateHealth()
		local health = getNumber(matchState, "BaseHealth", 100)
		local maxHealth = math.max(1, getNumber(matchState, "BaseMaxHealth", 100))
		if health == lastHealth and maxHealth == lastMaxHealth then
			return
		end
		if lastHealth >= 0 and health < lastHealth then
			popScale(barScale, 1.15) -- a barra "treme" quando a base leva dano
		end
		lastHealth = health
		lastMaxHealth = maxHealth

		local ratio = math.clamp(health / maxHealth, 0, 1)
		local color = LIME
		if ratio < LOW_HEALTH_RATIO then
			color = RED
		end

		local old = fillTween
		if old then
			old:Cancel()
		end
		local tween = TweenService:Create(fill, FILL_INFO, {
			Size = UDim2.fromScale(ratio, 1),
			BackgroundColor3 = color,
		})
		fillTween = tween
		tween:Play()

		healthText.Text = math.ceil(health) .. "/" .. math.ceil(maxHealth)
	end

	local function refreshAll()
		updateWave()
		updateState()
		updateHealth()
	end

	refreshAll()

	-- Atributos replicam sozinhos; basta ouvir a mudanca (sem remotes).
	table.insert(connections, matchState.AttributeChanged:Connect(refreshAll))

	-- Contagem regressiva: Heartbeat com acumulador (10 vezes por segundo).
	local accumulator = 0
	table.insert(
		connections,
		RunService.Heartbeat:Connect(function(dt: number)
			accumulator += dt
			if accumulator < COUNTDOWN_INTERVAL then
				return
			end
			accumulator = 0
			updateState()
		end)
	)
end

return HudController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001C">
						<Properties>
							<string name="Name">PlacementController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- PlacementController: hotbar de unidades (embaixo) + modo de colocacao + avisos (toasts).
-- REGRA DE OURO: o cliente NUNCA decide nada. Ele so manda PlaceUnit(kind, slotName)
-- e desenha o que o servidor responde (atributo Cash, atributo Occupied, UnitPlaced, Notify).
-- Mobile primeiro: tudo em Scale, alvos de toque grandes, texto com limite minimo de 12.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Config = require(Shared:WaitForChild("Config"))

-- Formato de uma unidade em Config.UNITS (copiado do SPEC; so os campos que a UI usa).
type UnitDef = {
	displayName: string,
	cost: number,
	color: Color3,
	accentColor: Color3,
}

type Card = {
	kind: string,
	cost: number,
	button: TextButton,
	scale: UIScale,
	stroke: UIStroke,
	dim: Frame,
	costLabel: TextLabel,
	accent: Color3,
	scaleTween: Tween?,
	glowTween: Tween?,
	dimTween: Tween?,
	affordable: boolean,
}

type SlotLook = {
	color: Color3,
	transparency: number,
}

type Toast = {
	group: CanvasGroup,
	moveTween: Tween?,
	fadeTween: Tween?,
	thread: thread?,
	dead: boolean,
}

local DARK = Color3.fromRGB(20, 12, 40)
local PINK = Color3.fromRGB(255, 51, 153)
local CYAN = Color3.fromRGB(0, 240, 255)
local YELLOW = Color3.fromRGB(255, 225, 60)
local RED = Color3.fromRGB(255, 50, 70)
local WHITE = Color3.new(1, 1, 1)

-- Vocabulario de animacao (criado uma vez so, reaproveitado).
local FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local POP = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local GLOW = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local SLOT_PULSE = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local TOAST_IN = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TOAST_OUT = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local CARD_REST = 1
local CARD_SELECTED = 1.08
local CARD_PRESSED = 0.92
local DIM_AMOUNT = 0.55
local MAX_TOASTS = 3
local TOAST_SECONDS = 2
local TOAST_STEP = 0.36 -- distancia vertical (escala do container) entre toasts empilhados
local TAP_MAX_MOVE = 14 -- pixels: mais que isso o toque virou arrasto de camera, nao clique
local TAP_MAX_TIME = 0.35
local RAY_LENGTH = 2000

-- Atalhos de teclado: a posicao na lista vira a tecla (1, 2, 3...).
local NUMBER_KEYS: { Enum.KeyCode } = {
	Enum.KeyCode.One,
	Enum.KeyCode.Two,
	Enum.KeyCode.Three,
	Enum.KeyCode.Four,
	Enum.KeyCode.Five,
}

local PlacementController = {}

local connections: { RBXScriptConnection } = {}

function PlacementController.init() end

function PlacementController.start()
	local localPlayer = Players.LocalPlayer
	local playerGui = localPlayer:WaitForChild("PlayerGui")

	local units = Config.UNITS :: { [string]: UnitDef }
	local order = Config.UNIT_ORDER :: { string }

	local placeRemote = Net.event("PlaceUnit")
	local placedRemote = Net.event("UnitPlaced")
	local notifyRemote = Net.event("Notify")

	local gui = Instance.new("ScreenGui")
	gui.Name = "Placement"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets -- nao fica embaixo do notch/home bar
	gui.Parent = playerGui

	---------------------------------------------------------------------------
	-- Estado
	---------------------------------------------------------------------------
	local cards: { Card } = {}
	local selected: Card? = nil
	local slotFolder: Instance? = nil
	local slotOriginals: { [BasePart]: SlotLook } = {}
	local slotTweens: { [BasePart]: Tween } = {}
	local slotConnections: { RBXScriptConnection } = {}
	local toasts: { Toast } = {} -- indice 1 = mais novo
	local touchInput: InputObject? = nil
	local touchStart = Vector2.zero
	local touchTime = 0

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Include

	---------------------------------------------------------------------------
	-- Ajudantes de tween
	---------------------------------------------------------------------------
	-- Cada elemento guarda o seu tween atual: cancelamos antes de criar outro,
	-- senao dois tweens brigam pela mesma propriedade.
	local function tweenCardScale(card: Card, target: number, info: TweenInfo)
		local old = card.scaleTween
		if old then
			old:Cancel()
		end
		local tween = TweenService:Create(card.scale, info, { Scale = target })
		card.scaleTween = tween
		tween:Play()
	end

	local function restScale(card: Card): number
		if selected == card then
			return CARD_SELECTED
		end
		return CARD_REST
	end

	---------------------------------------------------------------------------
	-- Toasts (avisos no topo)
	---------------------------------------------------------------------------
	local toastHolder = Instance.new("Frame")
	toastHolder.Name = "Toasts"
	toastHolder.AnchorPoint = Vector2.new(0.5, 0)
	toastHolder.Position = UDim2.fromScale(0.5, 0.2)
	toastHolder.Size = UDim2.fromScale(0.42, 0.22)
	toastHolder.BackgroundTransparency = 1
	toastHolder.Parent = gui

	local function toastPosition(index: number): UDim2
		return UDim2.fromScale(0.5, (index - 1) * TOAST_STEP)
	end

	local function layoutToasts()
		for index, toast in toasts do
			local old = toast.moveTween
			if old then
				old:Cancel()
			end
			local tween = TweenService:Create(toast.group, TOAST_IN, { Position = toastPosition(index) })
			toast.moveTween = tween
			tween:Play()
		end
	end

	local function dismissToast(toast: Toast)
		if toast.dead then
			return
		end
		toast.dead = true
		local index = table.find(toasts, toast)
		if index then
			table.remove(toasts, index)
		end
		local thread = toast.thread
		if thread and thread ~= coroutine.running() then
			task.cancel(thread) -- nao deixa o timer de 2s rodando a toa
		end
		toast.thread = nil
		local fade = TweenService:Create(toast.group, TOAST_OUT, { GroupTransparency = 1 })
		toast.fadeTween = fade
		fade.Completed:Once(function()
			toast.group:Destroy()
		end)
		fade:Play()
		layoutToasts()
	end

	local function showToast(text: string)
		-- Limite de 3 empilhados: o mais velho (final da lista) sai.
		while #toasts >= MAX_TOASTS do
			dismissToast(toasts[#toasts])
		end

		local group = Instance.new("CanvasGroup") -- 1 propriedade (GroupTransparency) apaga tudo junto
		group.Name = "Toast"
		group.AnchorPoint = Vector2.new(0.5, 0)
		group.Size = UDim2.fromScale(1, 0.3)
		group.Position = UDim2.fromScale(0.5, -0.5) -- comeca acima e escorrega para dentro
		group.BackgroundColor3 = DARK
		group.GroupTransparency = 1
		group.Parent = toastHolder

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.3, 0)
		corner.Parent = group

		local bar = Instance.new("Frame") -- barrinha rosa na esquerda: deixa o aviso com cara de anime
		bar.Size = UDim2.fromScale(0.025, 1)
		bar.BackgroundColor3 = PINK
		bar.BorderSizePixel = 0
		bar.Parent = group

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.92, 0.7)
		label.AnchorPoint = Vector2.new(0.5, 0.5)
		label.Position = UDim2.fromScale(0.53, 0.5)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = WHITE
		label.Text = string.sub(text, 1, 60)
		label.Parent = group

		local limit = Instance.new("UITextSizeConstraint")
		limit.MinTextSize = 12
		limit.MaxTextSize = 28
		limit.Parent = label

		local toast: Toast = { group = group, moveTween = nil, fadeTween = nil, thread = nil, dead = false }
		table.insert(toasts, 1, toast)
		layoutToasts()
		TweenService:Create(group, FAST, { GroupTransparency = 0 }):Play()

		toast.thread = task.delay(TOAST_SECONDS, function()
			toast.thread = nil
			dismissToast(toast)
		end)
	end

	---------------------------------------------------------------------------
	-- Slots: destaque LOCAL (so na nossa tela) enquanto estamos colocando
	---------------------------------------------------------------------------
	local function restoreSlot(slot: BasePart)
		local tween = slotTweens[slot]
		if tween then
			tween:Cancel()
			slotTweens[slot] = nil
		end
		local look = slotOriginals[slot]
		if look then
			slot.Color = look.color
			slot.Transparency = look.transparency
		end
	end

	local function pulseSlot(slot: BasePart)
		local look = slotOriginals[slot]
		if not look then
			return
		end
		local tween = TweenService:Create(slot, SLOT_PULSE, {
			Color = CYAN,
			Transparency = math.max(0, look.transparency - 0.35),
		})
		slotTweens[slot] = tween
		tween:Play()
	end

	local function endSlotHighlight()
		-- Devolve o visual original de TODOS os slots (por isso guardamos os originais).
		for _, conn in slotConnections do
			conn:Disconnect()
		end
		table.clear(slotConnections)
		for slot in slotOriginals do
			restoreSlot(slot)
		end
		table.clear(slotOriginals)
	end

	local function beginSlotHighlight()
		local folder = slotFolder
		if not folder then
			return
		end
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") then
				local slot: BasePart = child
				slotOriginals[slot] = { color = slot.Color, transparency = slot.Transparency }
				if slot:GetAttribute("Occupied") ~= true then
					pulseSlot(slot) -- livre: pulsa forte
				end -- ocupado: continua apagado (visual original)

				-- Se o servidor ocupar o slot enquanto olhamos, ele para de pulsar.
				table.insert(
					slotConnections,
					slot:GetAttributeChangedSignal("Occupied"):Connect(function()
						if slot:GetAttribute("Occupied") == true then
							restoreSlot(slot)
						elseif not slotTweens[slot] then
							pulseSlot(slot)
						end
					end)
				)
			end
		end
	end

	---------------------------------------------------------------------------
	-- Hotbar
	---------------------------------------------------------------------------
	local hotbar = Instance.new("Frame")
	hotbar.Name = "Hotbar"
	hotbar.AnchorPoint = Vector2.new(0.5, 1)
	hotbar.Position = UDim2.fromScale(0.5, 0.98)
	hotbar.Size = UDim2.fromScale(0.62, 0.2)
	hotbar.BackgroundTransparency = 1
	hotbar.Parent = gui

	local hotbarLimit = Instance.new("UISizeConstraint") -- no PC nao vira uma faixa gigante
	hotbarLimit.MaxSize = Vector2.new(760, 170)
	hotbarLimit.Parent = hotbar

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0.02, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = hotbar

	-- Dica + botao X, aparecem so no modo de colocacao.
	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.fromScale(0.5, 0.77)
	hint.Size = UDim2.fromScale(0.34, 0.05)
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.GothamBlack
	hint.TextScaled = true
	hint.TextColor3 = CYAN
	hint.Text = "Tap a glowing slot"
	hint.Visible = false
	hint.Parent = gui
	local hintLimit = Instance.new("UITextSizeConstraint")
	hintLimit.MinTextSize = 12
	hintLimit.MaxTextSize = 24
	hintLimit.Parent = hint
	local hintStroke = Instance.new("UIStroke")
	hintStroke.Color = DARK
	hintStroke.Thickness = 2
	hintStroke.Parent = hint

	local cancelButton = Instance.new("TextButton")
	cancelButton.Name = "Cancel"
	cancelButton.AnchorPoint = Vector2.new(0.5, 1)
	cancelButton.Position = UDim2.fromScale(0.5, 0.835)
	cancelButton.Size = UDim2.fromScale(0.16, 0.06)
	cancelButton.BackgroundColor3 = RED
	cancelButton.AutoButtonColor = false
	cancelButton.Font = Enum.Font.GothamBlack
	cancelButton.TextScaled = true
	cancelButton.TextColor3 = WHITE
	cancelButton.Text = "X  CANCEL"
	cancelButton.Visible = false
	cancelButton.Parent = gui
	local cancelCorner = Instance.new("UICorner")
	cancelCorner.CornerRadius = UDim.new(0.5, 0)
	cancelCorner.Parent = cancelButton
	local cancelLimit = Instance.new("UITextSizeConstraint")
	cancelLimit.MinTextSize = 12
	cancelLimit.MaxTextSize = 24
	cancelLimit.Parent = cancelButton
	local cancelSizeLimit = Instance.new("UISizeConstraint") -- alvo de toque nunca fica pequeno demais
	cancelSizeLimit.MinSize = Vector2.new(110, 40)
	cancelSizeLimit.Parent = cancelButton
	local cancelScale = Instance.new("UIScale")
	cancelScale.Parent = cancelButton
	local cancelPop: Tween? = nil

	local function popCancel()
		local old = cancelPop
		if old then
			old:Cancel()
		end
		cancelScale.Scale = 0.6
		local tween = TweenService:Create(cancelScale, POP, { Scale = 1 })
		cancelPop = tween
		tween:Play()
	end

	-- Visual de um card: selecionado = brilho pulsando + maior; normal = quieto.
	local function renderCard(card: Card)
		local isSelected = selected == card
		local oldGlow = card.glowTween
		if oldGlow then
			oldGlow:Cancel()
			card.glowTween = nil
		end
		if isSelected then
			card.stroke.Color = WHITE
			local glow = TweenService:Create(card.stroke, GLOW, { Thickness = 8, Color = card.accent })
			card.glowTween = glow
			glow:Play()
		else
			card.stroke.Thickness = 3
			card.stroke.Color = card.accent
		end
		tweenCardScale(card, restScale(card), POP)
	end

	local function setSelected(card: Card?)
		local previous = selected
		if previous == card then
			return
		end
		local wasActive = previous ~= nil
		selected = card
		if previous then
			renderCard(previous)
		end
		if card then
			renderCard(card)
		end

		local active = card ~= nil
		hint.Visible = active
		cancelButton.Visible = active
		if active and not wasActive then
			popCancel()
			beginSlotHighlight()
		elseif not active then
			endSlotHighlight() -- volta o visual original dos slots
		end
	end

	local function exitPlacement()
		setSelected(nil)
	end

	local function updateAffordability(playPop: boolean)
		local cash = 0
		local value = localPlayer:GetAttribute("Cash")
		if typeof(value) == "number" then
			cash = value
		end
		for _, card in cards do
			local affordable = cash >= card.cost
			if affordable ~= card.affordable then
				card.affordable = affordable
				local oldDim = card.dimTween
				if oldDim then
					oldDim:Cancel()
				end
				local dimTween = TweenService:Create(card.dim, FAST, {
					BackgroundTransparency = if affordable then 1 else DIM_AMOUNT,
				})
				card.dimTween = dimTween
				dimTween:Play()
				card.costLabel.TextColor3 = if affordable then YELLOW else RED
				if affordable and playPop then
					-- Acabou de ficar acessivel: chama atencao com um pop.
					card.scale.Scale = restScale(card) * 1.15
					tweenCardScale(card, restScale(card), POP)
				end
			end
		end
	end

	local function makeCard(kind: string, def: UnitDef, index: number, count: number)
		local button = Instance.new("TextButton")
		button.Name = "Card_" .. kind
		button.LayoutOrder = index
		-- Largura reparte o espaco da hotbar igualmente (Scale, funciona em qualquer tela).
		button.Size = UDim2.fromScale((1 - 0.02 * (count - 1)) / count, 0.92)
		button.BackgroundColor3 = DARK
		button.AutoButtonColor = false -- o feedback e o nosso (squash), nao o padrao
		button.Text = ""
		button.Parent = hotbar

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.14, 0)
		corner.Parent = button

		local stroke = Instance.new("UIStroke")
		stroke.Color = def.accentColor
		stroke.Thickness = 3
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button

		local uiScale = Instance.new("UIScale")
		uiScale.Parent = button

		-- "Retrato": quadrado colorido (cor da unidade) com borda neon (cor de destaque).
		local portrait = Instance.new("Frame")
		portrait.Name = "Portrait"
		portrait.AnchorPoint = Vector2.new(0, 0.5)
		portrait.Position = UDim2.fromScale(0.06, 0.5)
		portrait.Size = UDim2.fromScale(0.3, 0.7)
		portrait.BackgroundColor3 = def.color
		portrait.BorderSizePixel = 0
		portrait.Parent = button
		local portraitAspect = Instance.new("UIAspectRatioConstraint") -- sempre quadrado
		portraitAspect.AspectRatio = 1
		portraitAspect.AspectType = Enum.AspectType.FitWithinMaxAxis
		portraitAspect.Parent = portrait
		local portraitCorner = Instance.new("UICorner")
		portraitCorner.CornerRadius = UDim.new(0.2, 0)
		portraitCorner.Parent = portrait
		local portraitStroke = Instance.new("UIStroke")
		portraitStroke.Color = def.accentColor
		portraitStroke.Thickness = 3
		portraitStroke.Parent = portrait

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "Name"
		nameLabel.Position = UDim2.fromScale(0.42, 0.1)
		nameLabel.Size = UDim2.fromScale(0.54, 0.4)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.GothamBlack
		nameLabel.TextScaled = true
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextColor3 = WHITE
		nameLabel.Text = def.displayName
		nameLabel.Parent = button
		local nameLimit = Instance.new("UITextSizeConstraint")
		nameLimit.MinTextSize = 12
		nameLimit.MaxTextSize = 26
		nameLimit.Parent = nameLabel

		local costLabel = Instance.new("TextLabel")
		costLabel.Name = "Cost"
		costLabel.Position = UDim2.fromScale(0.42, 0.52)
		costLabel.Size = UDim2.fromScale(0.54, 0.36)
		costLabel.BackgroundTransparency = 1
		costLabel.Font = Enum.Font.GothamBlack
		costLabel.TextScaled = true
		costLabel.TextXAlignment = Enum.TextXAlignment.Left
		costLabel.TextColor3 = YELLOW
		costLabel.Text = "$" .. math.floor(def.cost)
		costLabel.Parent = button
		local costLimit = Instance.new("UITextSizeConstraint")
		costLimit.MinTextSize = 12
		costLimit.MaxTextSize = 24
		costLimit.Parent = costLabel

		-- Numero do atalho (so serve no PC, mas e pequeno e nao atrapalha).
		if index <= #NUMBER_KEYS and not UserInputService.TouchEnabled then
			local keyLabel = Instance.new("TextLabel")
			keyLabel.Name = "Key"
			keyLabel.Position = UDim2.fromScale(0.03, 0.03)
			keyLabel.Size = UDim2.fromScale(0.12, 0.22)
			keyLabel.BackgroundTransparency = 1
			keyLabel.Font = Enum.Font.GothamBold
			keyLabel.TextScaled = true
			keyLabel.TextColor3 = Color3.fromRGB(200, 215, 255)
			keyLabel.Text = tostring(index)
			keyLabel.Parent = button
			local keyLimit = Instance.new("UITextSizeConstraint")
			keyLimit.MinTextSize = 12
			keyLimit.MaxTextSize = 18
			keyLimit.Parent = keyLabel
		end

		-- Camada escura por cima: dimmed (sem dinheiro) = camada visivel.
		-- Active = false para nao roubar o clique do botao.
		local dim = Instance.new("Frame")
		dim.Name = "Dim"
		dim.Size = UDim2.fromScale(1, 1)
		dim.BackgroundColor3 = Color3.new(0, 0, 0)
		dim.BackgroundTransparency = 1
		dim.BorderSizePixel = 0
		dim.Active = false
		dim.ZIndex = 5
		dim.Parent = button
		local dimCorner = Instance.new("UICorner")
		dimCorner.CornerRadius = UDim.new(0.14, 0)
		dimCorner.Parent = dim

		local card: Card = {
			kind = kind,
			cost = def.cost,
			button = button,
			scale = uiScale,
			stroke = stroke,
			dim = dim,
			costLabel = costLabel,
			accent = def.accentColor,
			scaleTween = nil,
			glowTween = nil,
			dimTween = nil,
			affordable = true,
		}
		table.insert(cards, card)

		-- Aperta: encolhe rapido ("squash"). Solta: volta com Back (pop).
		table.insert(
			connections,
			button.MouseButton1Down:Connect(function()
				tweenCardScale(card, CARD_PRESSED, FAST)
			end)
		)
		table.insert(
			connections,
			button.MouseLeave:Connect(function()
				tweenCardScale(card, restScale(card), POP)
			end)
		)
		table.insert(
			connections,
			button.Activated:Connect(function()
				if not card.affordable and selected ~= card then
					-- So um aviso local de UX; quem decide de verdade e o servidor.
					showToast("Not enough cash!")
					tweenCardScale(card, restScale(card), POP)
					return
				end
				if selected == card then
					exitPlacement() -- tocar de novo cancela
				else
					setSelected(card)
				end
				tweenCardScale(card, restScale(card), POP)
			end)
		)
	end

	for index, kind in order do
		local def = units[kind]
		if def then
			makeCard(kind, def, index, #order)
		else
			warn("[PlacementController] Config.UNITS sem a unidade: " .. kind)
		end
	end

	---------------------------------------------------------------------------
	-- Colocar: raycast no mundo 3D so contra os slots
	---------------------------------------------------------------------------
	local function tryPlaceAt(screenPos: Vector2)
		local card = selected
		local folder = slotFolder
		local camera = workspace.CurrentCamera
		if not card or not folder or not camera then
			return
		end
		-- ScreenPointToRay ja considera a barra superior do Roblox (inset).
		local ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)
		raycastParams.FilterDescendantsInstances = { folder }
		local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
		if not result then
			return -- clicou no vazio: continua no modo
		end
		local slot = result.Instance
		if slot.Parent ~= folder then
			return
		end
		if slot:GetAttribute("Occupied") == true then
			showToast("Slot taken")
			return
		end
		-- So pedimos. Servidor valida tudo (estado, slot, limite, dinheiro) e responde.
		placeRemote:FireServer(card.kind, slot.Name)
		exitPlacement()
	end

	-- Cancelar
	table.insert(
		connections,
		cancelButton.Activated:Connect(function()
			exitPlacement()
		end)
	)

	-- Entrada: gameProcessed = true quer dizer que um botao/UI ja usou o clique.
	-- Sem isso, tocar num card tambem colocaria a unidade "atras" dele.
	table.insert(
		connections,
		UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
			if gameProcessed then
				return
			end
			local inputType = input.UserInputType
			if inputType == Enum.UserInputType.MouseButton1 then
				if selected then
					tryPlaceAt(Vector2.new(input.Position.X, input.Position.Y))
				end
			elseif inputType == Enum.UserInputType.Touch then
				-- Toque: so conta como "clique" se soltar perto e rapido (senao e arrastar a camera).
				touchInput = input
				touchStart = Vector2.new(input.Position.X, input.Position.Y)
				touchTime = os.clock()
			elseif inputType == Enum.UserInputType.Keyboard then
				local key = input.KeyCode
				if key == Enum.KeyCode.Q or key == Enum.KeyCode.Escape then
					exitPlacement()
					return
				end
				local index = table.find(NUMBER_KEYS, key)
				if index then
					local card = cards[index]
					if card then
						if not card.affordable and selected ~= card then
							showToast("Not enough cash!")
						elseif selected == card then
							exitPlacement()
						else
							setSelected(card)
						end
					end
				end
			end
		end)
	)

	table.insert(
		connections,
		UserInputService.InputEnded:Connect(function(input: InputObject, _gameProcessed: boolean)
			if input ~= touchInput then
				return
			end
			touchInput = nil
			if not selected then
				return
			end
			local endPos = Vector2.new(input.Position.X, input.Position.Y)
			if (endPos - touchStart).Magnitude <= TAP_MAX_MOVE and os.clock() - touchTime <= TAP_MAX_TIME then
				tryPlaceAt(endPos)
			end
		end)
	)

	---------------------------------------------------------------------------
	-- Respostas do servidor
	---------------------------------------------------------------------------
	table.insert(
		connections,
		notifyRemote.OnClientEvent:Connect(function(text: unknown)
			if typeof(text) == "string" then
				showToast(text)
			end
		end)
	)

	-- Se a nossa unidade foi criada e ainda estamos no modo, sai dele.
	table.insert(
		connections,
		placedRemote.OnClientEvent:Connect(function(_id: unknown, _kind: unknown, _position: unknown, ownerUserId: unknown)
			if ownerUserId == localPlayer.UserId and selected then
				exitPlacement()
			end
		end)
	)

	-- Dinheiro mudou -> atualiza cards escurecidos.
	table.insert(
		connections,
		localPlayer:GetAttributeChangedSignal("Cash"):Connect(function()
			updateAffordability(true)
		end)
	)
	updateAffordability(false)

	-- Acha a pasta de slots (pode demorar a replicar). Sem ela o modo so nao destaca nada.
	local map = workspace:WaitForChild("Map", 30)
	if map then
		local placement = map:WaitForChild("Placement", 30)
		if placement then
			slotFolder = placement
		end
	end
	if not slotFolder then
		warn("[PlacementController] workspace.Map.Placement nao apareceu; colocacao desativada.")
	end

	-- Se a partida entrar em estado onde nao pode colocar (ex.: Derrota), sai do modo.
	task.spawn(function()
		local matchState = ReplicatedStorage:WaitForChild("MatchState", 30)
		if not matchState then
			return
		end
		local allowed = Config.PLACE_ALLOWED_STATES :: { [string]: boolean }
		table.insert(
			connections,
			matchState:GetAttributeChangedSignal("State"):Connect(function()
				local state = matchState:GetAttribute("State")
				if selected and not (typeof(state) == "string" and allowed[state]) then
					exitPlacement()
				end
			end)
		)
	end)
end

return PlacementController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0000001D">
						<Properties>
							<string name="Name">UnitFxController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- UnitFxController: "vida" das unidades (so no cliente, so visual).
-- Faz 3 coisas com UM unico loop de RenderStepped:
--   1) pop-in: unidade nova cresce de 0.2 ate 1 com efeito "Back" (passa um pouco e volta);
--   2) pulso: o ataque faz a unidade dar uma "inchada" rapida (1 -> 1.08 -> 1);
--   3) idle: partes neon pulsam de leve e o orb do Mage flutua (se der para mexer nele).
-- Para ficar leve no celular: listas de partes sao criadas UMA vez por unidade (no registro),
-- e o loop nao cria tabelas nem Instances.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local POP_START_SCALE = 0.2
local POP_DURATION = 0.45
local PULSE_DURATION = 0.18
local PULSE_STRENGTH = 0.08
local PULSE_SPEED = 3 -- velocidade do brilho neon
local PULSE_DEPTH = 0.3 -- o quanto o neon fica transparente no ponto mais fraco
local BOB_HEIGHT = 0.35 -- studs que o orb sobe e desce
local BOB_SPEED = 2.2

type UnitState = {
	model: Model,
	parts: { BasePart }, -- partes neon (menos o Root)
	baseTransparency: { number },
	partCount: number,
	phase: number, -- cada unidade pulsa em um ritmo diferente
	popTime: number, -- segundos desde o inicio do pop; negativo = sem pop
	pulseTime: number, -- segundos desde o ataque; negativo = sem pulso
	appliedScale: number,
	orbWeld: Weld?, -- junta que prende o orb ao corpo (se o servidor usou Weld)
	orbBaseC0: CFrame,
}

local UnitFxController = {}

local connections: { RBXScriptConnection } = {}
local renderConnection: RBXScriptConnection? = nil
local states: { [Model]: UnitState } = {}
local statesById: { [string]: UnitState } = {}

-- Procura o Weld que prende o orb. WeldConstraint nao tem offset editavel, entao so Weld serve.
local function findOrbWeld(model: Model, orb: BasePart): Weld?
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Weld") and descendant.Part1 == orb then
			return descendant
		end
	end
	return nil
end

local function register(model: Model, withPop: boolean)
	if states[model] then
		return
	end
	local root = model:FindFirstChild("Root")
	if not root then
		return
	end

	local parts: { BasePart } = {}
	local bases: { number } = {}
	local orb: BasePart? = nil
	local kind = model:GetAttribute("Kind")
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= root and descendant.Material == Enum.Material.Neon then
			table.insert(parts, descendant)
			table.insert(bases, descendant.Transparency)
			local isOrbName = string.find(string.lower(descendant.Name), "orb", 1, true) ~= nil
			if orb == nil and (isOrbName or (kind == "Mage" and descendant.Shape == Enum.PartType.Ball)) then
				orb = descendant
			end
		end
	end

	local weld: Weld? = nil
	local baseC0 = CFrame.new()
	if orb then
		weld = findOrbWeld(model, orb)
		if weld then
			baseC0 = weld.C0
		end
	end

	local state: UnitState = {
		model = model,
		parts = parts,
		baseTransparency = bases,
		partCount = #parts,
		phase = math.random() * math.pi * 2,
		popTime = if withPop then 0 else -1,
		pulseTime = -1,
		appliedScale = 1,
		orbWeld = weld,
		orbBaseC0 = baseC0,
	}
	states[model] = state
	local id = model:GetAttribute("Id")
	if typeof(id) == "string" then
		statesById[id] = state
	end

	if withPop then
		-- Ja nasce pequena para nao piscar no tamanho cheio antes do primeiro frame do loop.
		model:ScaleTo(POP_START_SCALE)
		state.appliedScale = POP_START_SCALE
	end
end

local function unregister(model: Model)
	local state = states[model]
	if not state then
		return
	end
	states[model] = nil
	local id = model:GetAttribute("Id")
	if typeof(id) == "string" and statesById[id] == state then
		statesById[id] = nil
	end
end

local function onChildAdded(child: Instance, withPop: boolean)
	if not child:IsA("Model") then
		return
	end
	if child:FindFirstChild("Root") then
		register(child, withPop)
		return
	end
	-- O Root ainda nao chegou (streaming): espera um pouco sem travar nada.
	task.spawn(function()
		if child:WaitForChild("Root", 5) and child.Parent then
			register(child, withPop)
		end
	end)
end

local function onUnitAttacked(id: string, _kind: string, _from: Vector3, _to: Vector3)
	if typeof(id) ~= "string" then
		return
	end
	local state = statesById[id]
	if state then
		state.pulseTime = 0 -- reinicia o pulso (rajada de ataques fica "vibrando")
	end
end

-- UM loop para todas as unidades. Sem tabelas novas, sem Instance.new.
local function onRenderStep(dt: number)
	local now = os.clock()
	for model, state in states do
		local scale = 1

		-- Pop-in com easing Back (calculado na mao, sem criar Tween).
		if state.popTime >= 0 then
			state.popTime += dt
			local alpha = state.popTime / POP_DURATION
			if alpha >= 1 then
				state.popTime = -1
			else
				local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				scale = POP_START_SCALE + (1 - POP_START_SCALE) * eased
			end
		end

		-- Pulso de ataque: seno de 0 a pi = sobe e desce uma vez.
		if state.pulseTime >= 0 then
			state.pulseTime += dt
			if state.pulseTime >= PULSE_DURATION then
				state.pulseTime = -1
			else
				scale *= 1 + PULSE_STRENGTH * math.sin(math.pi * state.pulseTime / PULSE_DURATION)
			end
		end

		-- So chama ScaleTo se a escala mudou de verdade (ScaleTo mexe em todas as partes).
		if math.abs(scale - state.appliedScale) > 0.001 then
			model:ScaleTo(scale)
			state.appliedScale = scale
		end

		-- Brilho neon pulsando.
		local wave = 0.5 + 0.5 * math.sin(now * PULSE_SPEED + state.phase)
		local parts = state.parts
		local bases = state.baseTransparency
		for i = 1, state.partCount do
			parts[i].Transparency = bases[i] + PULSE_DEPTH * wave * (1 - bases[i])
		end

		-- Orb flutuando: mexe so no offset da junta (o ScaleTo ja escalou o C0, entao recalculamos).
		local weld = state.orbWeld
		if weld then
			local base = state.orbBaseC0
			local bob = math.sin(now * BOB_SPEED + state.phase) * BOB_HEIGHT * state.appliedScale
			weld.C0 = CFrame.new(base.Position * state.appliedScale + Vector3.new(0, bob, 0)) * base.Rotation
		end
	end
end

function UnitFxController.init() end

function UnitFxController.start()
	local unitsFolder = workspace:WaitForChild("Units", 30)
	if not unitsFolder then
		warn("UnitFxController: workspace.Units nao apareceu")
		return
	end

	-- Unidades que ja existem quando entramos: sem pop (so as novas ganham o efeito).
	for _, child in unitsFolder:GetChildren() do
		onChildAdded(child, false)
	end
	table.insert(
		connections,
		unitsFolder.ChildAdded:Connect(function(child)
			onChildAdded(child, true)
		end)
	)
	table.insert(
		connections,
		unitsFolder.ChildRemoved:Connect(function(child)
			if child:IsA("Model") then
				unregister(child) -- libera a unidade da tabela (senao vazaria memoria)
			end
		end)
	)
	table.insert(connections, Net.event("UnitAttacked").OnClientEvent:Connect(onUnitAttacked))

	renderConnection = RunService.RenderStepped:Connect(onRenderStep)
end

-- Limpeza explicita (nao usada no jogo normal).
function UnitFxController.destroy()
	local loop = renderConnection
	if loop then
		loop:Disconnect()
		renderConnection = nil
	end
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	table.clear(states)
	table.clear(statesById)
end

return UnitFxController
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
	</Item>
