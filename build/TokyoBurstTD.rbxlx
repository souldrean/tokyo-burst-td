			<Item class="ModuleScript" referent="RBX00000003">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Config: todos os numeros "ajustaveis" do jogo ficam aqui.
-- Assim, para mudar a velocidade de um inimigo, voce mexe em UM lugar so.
-- table.freeze deixa a tabela somente leitura: ninguem muda um valor por engano.
-- ATENCAO: ENEMIES, WAVES, WAVE_TIMEOUT_SECONDS e INTERMISSION_SECONDS tem uma copia
-- em tools/sim_match.py. Se mudar aqui, mude la tambem (mantenha em sincronia).

local Types = require(script.Parent.Types)

local ENEMIES: { [string]: Types.EnemyDef } = {
	Grunt = {
		health = 20,
		speed = 20,
		baseDamage = 5,
		reward = 5,
		size = Vector3.new(2.4, 2.8, 2.4),
		color = Color3.fromRGB(170, 40, 60),
		eyeColor = Color3.fromRGB(255, 240, 80),
		horns = false,
	},
	Runner = {
		health = 12,
		speed = 32,
		baseDamage = 4,
		reward = 4,
		size = Vector3.new(1.8, 2.2, 1.8),
		color = Color3.fromRGB(255, 120, 30),
		eyeColor = Color3.fromRGB(255, 255, 255),
		horns = false,
	},
	Tank = {
		health = 90,
		speed = 14,
		baseDamage = 12,
		reward = 15,
		size = Vector3.new(4, 4.4, 4),
		color = Color3.fromRGB(90, 40, 140),
		eyeColor = Color3.fromRGB(255, 60, 60),
		horns = true,
	},
	Oni = {
		health = 600,
		speed = 12,
		baseDamage = 40,
		reward = 100,
		size = Vector3.new(6.5, 7.5, 6.5),
		color = Color3.fromRGB(200, 20, 20),
		eyeColor = Color3.fromRGB(255, 220, 0),
		horns = true,
	},
}

local WAVES: { Types.WaveDef } = {
	{ groups = { { kind = "Grunt", count = 5, interval = 1.2 } } },
	{ groups = { { kind = "Grunt", count = 8, interval = 1.0 } } },
	{ groups = { { kind = "Grunt", count = 6, interval = 1.0 }, { kind = "Runner", count = 4, interval = 0.8 } } },
	{ groups = { { kind = "Grunt", count = 8, interval = 0.8 }, { kind = "Tank", count = 2, interval = 2.0 } } },
	{ groups = { { kind = "Runner", count = 10, interval = 0.6 }, { kind = "Grunt", count = 6, interval = 0.8 } } },
	{ groups = { { kind = "Tank", count = 3, interval = 2.0 }, { kind = "Grunt", count = 10, interval = 0.7 } } },
	{ groups = { { kind = "Runner", count = 12, interval = 0.5 }, { kind = "Tank", count = 3, interval = 1.5 } } },
	{
		groups = {
			{ kind = "Grunt", count = 15, interval = 0.5 },
			{ kind = "Tank", count = 4, interval = 1.5 },
			{ kind = "Runner", count = 6, interval = 0.5 },
		},
	},
	{
		groups = {
			{ kind = "Tank", count = 6, interval = 1.0 },
			{ kind = "Runner", count = 14, interval = 0.4 },
			{ kind = "Grunt", count = 10, interval = 0.5 },
		},
	},
	{
		groups = {
			{ kind = "Grunt", count = 8, interval = 0.6 },
			{ kind = "Tank", count = 4, interval = 1.2 },
			{ kind = "Oni", count = 1, interval = 1.0 },
		},
		boss = true,
	},
}

local Config = {
	-- Cubo de teste da semana 1 (codigo mantido, mas desligado).
	PATH_PREVIEW_ENABLED = false,
	PATH_PREVIEW_SPEED = 20,
	PATH_PREVIEW_CUBE_SIZE = 3,
	PATH_PREVIEW_HEIGHT = 2,

	-- Partida
	INTERMISSION_SECONDS = 6, -- pausa antes da primeira onda
	RESTART_DELAY_SECONDS = 8, -- tempo na tela de Vitoria/Derrota antes de recomecar
	BASE_MAX_HEALTH = 100,
	WAVE_TIMEOUT_SECONDS = 15, -- depois disto a proxima onda comeca mesmo com inimigos vivos

	-- Servidor
	SERVER_TICK_RATE = 10, -- vezes por segundo que o servidor confere se inimigos chegaram ao fim
	MAX_ENEMIES_ALIVE = 60, -- limite de seguranca

	-- Debug (so no Studio)
	DEBUG_HIT_DAMAGE = 5,

	ENEMIES = ENEMIES,
	WAVES = WAVES,
}

return table.freeze(Config)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Net: acesso centralizado aos RemoteEvents.
-- No servidor: cria a pasta ReplicatedStorage.Remotes e cada evento sob demanda
-- (assim a ordem de init() entre sistemas nao importa).
-- No cliente: so espera o evento existir (cliente nunca cria remotes).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Types = require(script.Parent.Types)

export type RemoteName = Types.RemoteName

local FOLDER_NAME = "Remotes"
local CLIENT_TIMEOUT = 30

local Net = {}

local function getServerFolder(): Folder
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		assert(existing:IsA("Folder"), "Net: ReplicatedStorage.Remotes deveria ser uma Folder")
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	return folder
end

function Net.event(name: RemoteName): RemoteEvent
	if RunService:IsServer() then
		local folder = getServerFolder()
		local existing = folder:FindFirstChild(name)
		if existing then
			assert(existing:IsA("RemoteEvent"), `Net: "{name}" deveria ser um RemoteEvent`)
			return existing
		end
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		return remote
	end

	-- Cliente: espera com tempo limite e erro claro.
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_TIMEOUT)
	assert(folder, `Net: ReplicatedStorage.Remotes nao apareceu em {CLIENT_TIMEOUT}s`)
	local remote = folder:WaitForChild(name, CLIENT_TIMEOUT)
	assert(remote, `Net: o RemoteEvent "{name}" nao apareceu em {CLIENT_TIMEOUT}s`)
	assert(remote:IsA("RemoteEvent"), `Net: "{name}" deveria ser um RemoteEvent`)
	return remote
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000005">
				<Properties>
					<string name="Name">Types</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Types: tipos compartilhados entre servidor e cliente.
-- Tipos so existem para o verificador de codigo (nao rodam no jogo).
-- Um ModuleScript precisa devolver um valor, entao devolvemos uma tabela vazia
-- (devolver "nil" puro da erro no Roblox).

-- Dados pre-calculados de um caminho feito de pontos ligados por retas.
export type PathData = {
	points: { Vector3 }, -- os waypoints, em ordem
	lengths: { number }, -- lengths[i] = distancia do ponto i ate o ponto i+1
	total: number, -- comprimento total do caminho
}

-- Nomes dos RemoteEvents (a lista fica aqui para cliente e servidor concordarem).
export type RemoteName = "EnemyDied" | "BaseHit" | "WaveStarted" | "MatchEnded" | "DebugHitEnemy"

-- Por que um inimigo saiu do jogo: morto por nos ou chegou no fim (vazou).
export type DeathReason = "Killed" | "Leaked"

export type MatchResult = "Victory" | "Defeat"

-- Estados da partida (atributo State em ReplicatedStorage.MatchState).
export type MatchStateName = "Waiting" | "Intermission" | "Wave" | "Victory" | "Defeat"

-- Payloads (ordem dos argumentos de cada RemoteEvent, servidor -> clientes):
--   EnemyDied(id: string, reason: DeathReason, position: Vector3, reward: number)
--   BaseHit(damage: number, healthLeft: number)
--   WaveStarted(wave: number, waveCount: number, isBoss: boolean)
--   MatchEnded(result: MatchResult)
--   DebugHitEnemy(id: string)   <- cliente -> servidor (so no Studio)
export type EnemyDiedPayload = {
	id: string,
	reason: DeathReason,
	position: Vector3,
	reward: number,
}

-- Dados de um tipo de inimigo (vem do Config.ENEMIES).
export type EnemyDef = {
	health: number,
	speed: number,
	baseDamage: number,
	reward: number,
	size: Vector3,
	color: Color3,
	eyeColor: Color3,
	horns: boolean,
}

-- Um grupo de inimigos do mesmo tipo dentro de uma onda.
export type WaveGroup = {
	kind: string,
	count: number,
	interval: number, -- segundos entre cada spawn
}

export type WaveDef = {
	groups: { WaveGroup },
	boss: boolean?,
}

return {}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000006">
