						<CoordinateFrame name="CFrame"><X>-80.0</X><Y>0.0</Y><Z>70.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
						<Color3uint8 name="Color3uint8">4281216568</Color3uint8>
						<token name="Material">1376</token>
